    // ━━━ Detect conversational questions (should go to AI, not keywords) ━━━
    function isConversational(message: string): boolean {
      const lower = message.toLowerCase();
      const patterns = [
        'why', 'how come', 'what do you think', 'opinion', 'feel about',
        'think about', 'thoughts on', 'is he', 'is she', 'do you like',
        'should i', 'would you', 'how did', 'what happened', 'what if',
        'reason', 'motivation', 'story behind', 'tell me more',
        'elaborate', 'explain why', 'what else', 'and how', 'and why',
        'how is', 'how was', 'how does', 'why does', 'why did', 'why is',
        'why do', 'what kind of person', 'what type of person',
      ];
      return patterns.some(p => lower.includes(p));
    }

    // ━━━ Bot Response Finder ━━━
    function findBotResponse(message: string): { answer: string; followUp?: string[]; matched: boolean } {
      const lower = message.toLowerCase();
      let bestMatch: { answer: string; followUp?: string[] } | null = null;
      let bestScore = 0;

      for (const [keywords, response] of Object.entries(botResponses)) {
        const keywordList = keywords.split('|');
        let score = 0;
        for (const kw of keywordList) {
          if (kw.length <= 3) {
            if (new RegExp(`\\b${kw}\\b`, 'i').test(lower)) score += kw.length;
          } else {
            if (lower.includes(kw)) score += kw.length;
          }
        }
        if (score > bestScore) { bestScore = score; bestMatch = response; }
      }

      if (bestMatch && bestScore >= 3) return { ...bestMatch, matched: true };
      return { answer: '', matched: false };
    }

