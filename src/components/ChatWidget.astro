---
/**
 * ChatWidget.astro
 * Floating AI chat widget with Supabase-backed human handoff.
 * Sits in bottom-right corner, works on all pages.
 */
---

<!-- ━━━ Chat Toggle Button ━━━ -->
<button
  id="chat-toggle"
  class="fixed bottom-6 right-6 w-14 h-14 bg-green-600 dark:bg-green-500 text-white dark:text-zinc-950 rounded-full shadow-xl dark:shadow-green-500/20 flex items-center justify-center hover:bg-green-700 dark:hover:bg-green-400 hover:scale-110 hover:shadow-2xl hover:shadow-green-600/40 dark:hover:shadow-green-500/30 transition-[background-color,box-shadow,transform,opacity,bottom] duration-300 group"
  style="z-index: 9999;"
  aria-label="Open chat"
>
  <!-- Chat icon -->
  <svg id="chat-icon-open" class="w-6 h-6 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>
  </svg>
  <!-- Close icon -->
  <svg id="chat-icon-close" class="w-6 h-6 absolute opacity-0 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
    <path d="M6 18L18 6M6 6l12 12"/>
  </svg>
  
  <!-- Notification dot -->
  <span id="chat-notification" class="absolute -top-1 -right-1 w-5 h-5 bg-red-500 rounded-full flex items-center justify-center text-[10px] font-bold text-white border-2 border-white dark:border-green-500">
    1
  </span>
</button>

<!-- ━━━ Chat Window ━━━ -->
<div
  id="chat-window"
  class="fixed bottom-24 right-6 w-[380px] max-w-[calc(100vw-2rem)] opacity-0 scale-95 translate-y-4 pointer-events-none transition-all duration-300 ease-out"
  style="z-index: 9998;"
  aria-hidden="true"
>
  <div class="bg-white dark:bg-zinc-900 rounded-2xl shadow-2xl dark:shadow-2xl dark:shadow-black/50 border border-zinc-200 dark:border-zinc-700 overflow-hidden flex flex-col" style="height: min(600px, calc(100vh - 140px));">
    
    <!-- ━━━ Chat Header ━━━ -->
    <div class="bg-green-600 dark:bg-green-500 px-5 py-4 flex items-center gap-3 shrink-0">
      <div class="relative">
        <div class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>
          </svg>
        </div>
        <!-- Assistant availability indicator -->
        <span class="absolute -bottom-0.5 -right-0.5 w-3.5 h-3.5 bg-green-400 dark:bg-green-300 rounded-full border-2 border-green-600 dark:border-green-500"></span>
      </div>
      <div class="flex-1">
        <h3 class="text-white font-semibold text-sm">Reve Stitching</h3>
        <p class="text-green-200 text-xs">Virtual assistant • Human handoff available</p>
      </div>
      <!-- Reset Chat Button -->
      <button
        id="chat-reset-btn"
        class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-white/80 hover:bg-white/20 hover:text-white transition-colors"
        aria-label="Start new chat"
        title="Start new chat"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 12a9 9 0 019-9 9.75 9.75 0 016.74 2.74L21 8"/>
          <path d="M21 3v5h-5"/>
          <path d="M21 12a9 9 0 01-9 9 9.75 9.75 0 01-6.74-2.74L3 16"/>
          <path d="M3 21v-5h5"/>
        </svg>
      </button>
      <!-- Minimize Button -->
      <button
        id="chat-minimize"
        class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-white/80 hover:bg-white/20 hover:text-white transition-colors"
        aria-label="Minimize chat"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"/></svg>
      </button>
    </div>

    <!-- ━━━ Chat Messages ━━━ -->
    <div id="chat-messages" class="flex-1 overflow-y-auto px-4 py-4 space-y-4 scroll-smooth bg-zinc-50 dark:bg-zinc-900/50">
      <!-- Messages inserted by JavaScript -->
    </div>

    <!-- ━━━ Quick Replies ━━━ -->
    <div id="chat-quick-replies" class="px-4 pb-3 shrink-0">
      <div class="flex flex-wrap gap-2" id="quick-replies-container">
        <!-- Quick replies inserted by JavaScript -->
      </div>
    </div>

    <!-- ━━━ Chat Input ━━━ -->
    <div class="px-4 pb-4 pt-2 border-t border-zinc-100 dark:border-zinc-800 shrink-0 bg-white dark:bg-zinc-900">
      <form id="chat-form" class="flex items-center gap-2">
        <textarea
          id="chat-input"
          placeholder="Type your message..."
          autocomplete="off"
          maxlength="1200"
          rows="1"
          class="flex-1 px-4 py-3 bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl text-sm text-zinc-900 dark:text-white placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:border-green-600 dark:focus:border-green-500 focus:ring-2 focus:ring-green-600/20 dark:focus:ring-green-500/20 transition-all resize-none overflow-hidden"
          style="max-height: 120px;"
        ></textarea>
        <button
          id="chat-send-btn"
          type="submit"
          class="w-11 h-11 bg-green-600 dark:bg-green-500 text-white dark:text-zinc-950 rounded-xl flex items-center justify-center hover:bg-green-700 dark:hover:bg-green-400 disabled:cursor-not-allowed disabled:opacity-60 transition-colors shrink-0"
          aria-label="Send message"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
        </button>
      </form>
      <p class="text-[10px] text-zinc-400 dark:text-zinc-500 text-center mt-2">
        Powered by Reve Stitching • <button id="request-human-btn" class="text-green-600 dark:text-green-400 hover:underline font-medium">Talk to a human</button>
      </p>
    </div>
  </div>
</div>

<!-- ━━━ Styles ━━━ -->
<style>
  @media (max-width: 480px) {
    #chat-window {
      bottom: 0 !important;
      right: 0 !important;
      width: 100% !important;
      max-width: 100% !important;
    }
    
    #chat-window > div {
      border-radius: 1rem 1rem 0 0 !important;
      height: calc(100vh - 80px) !important;
      max-height: none !important;
    }

    #chat-window.pointer-events-auto ~ #chat-toggle,
    #chat-window:not(.pointer-events-none) + #chat-toggle {
      display: none !important;
    }
  }
  
  .typing-dot {
    animation: typingBounce 1.4s infinite ease-in-out both;
  }
  .typing-dot:nth-child(1) { animation-delay: 0s; }
  .typing-dot:nth-child(2) { animation-delay: 0.2s; }
  .typing-dot:nth-child(3) { animation-delay: 0.4s; }
  
  @keyframes typingBounce {
    0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
    40% { transform: scale(1); opacity: 1; }
  }
  
  .chat-msg {
    animation: msgSlide 0.3s ease-out forwards;
  }
  
  @keyframes msgSlide {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<!-- ━━━ Script ━━━ -->
<script>
  document.addEventListener('astro:page-load', () => {

    // ━━━ Elements ━━━
    const toggle = document.getElementById('chat-toggle');
    const chatWindow = document.getElementById('chat-window');
    const minimize = document.getElementById('chat-minimize');
    const messages = document.getElementById('chat-messages');
    const form = document.getElementById('chat-form');
    const input = document.getElementById('chat-input') as HTMLTextAreaElement;
    const sendButton = document.getElementById('chat-send-btn') as HTMLButtonElement | null;
    const quickContainer = document.getElementById('quick-replies-container');
    const notification = document.getElementById('chat-notification');
    const iconOpen = document.getElementById('chat-icon-open');
    const iconClose = document.getElementById('chat-icon-close');
    const humanBtn = document.getElementById('request-human-btn');

    let isOpen = false;
    let isSending = false;
    let requestSequence = 0;

    function setSending(sending: boolean): void {
      isSending = sending;
      if (input) input.disabled = sending;
      if (sendButton) sendButton.disabled = sending;
      form?.setAttribute('aria-busy', String(sending));
    }

    // Clean up old intervals from previous page loads (View Transitions)
    if ((window as any).__chatPollInterval) {
      clearInterval((window as any).__chatPollInterval);
      (window as any).__chatPollInterval = null;
    }
    if ((window as any).__chatHeartbeatInterval) {
      clearInterval((window as any).__chatHeartbeatInterval);
      (window as any).__chatHeartbeatInterval = null;
    }
    let pollInterval: ReturnType<typeof setInterval> | null = null;
    let lastPollTimestamp = new Date().toISOString();
    const seenMessageIds = new Set();

    // ━━━ Session Storage Keys ━━━
    const SK = {
      messages: 'reve-chat-messages',
      hasOpened: 'reve-chat-opened',
      wasOpen: 'reve-chat-was-open',
      mode: 'reve-chat-mode',
      sessionId: 'reve-chat-session-id',
      visitorToken: 'reve-chat-visitor-token',
    };

    // ━━━ Icon SVGs ━━━
    const botIconSvg = `<svg class="w-3.5 h-3.5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>`;

    const adminIconSvg = `<svg class="w-3.5 h-3.5 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>`;

    // Business knowledge is supplied server-side to Gemini.
    // ━━━ Quick Reply Map ━━━
const quickReplyMap: Record<string, string> = {
  'Product range': 'What products do you manufacture?',
  'MOQ details': 'What is your minimum order quantity?',
  'Get a quote': 'I want to get a price quote',
  'Lead time': 'What is your production lead time?',
  'Quality standards': 'What quality standards do you maintain?',
  'Certifications': 'What certifications do you have?',
  'Fabric types': 'What fabric types do you work with?',
  'Request human': 'I want to talk to a human representative',
  'Contact team': 'How can I contact your team?',
  'Contact Basit': 'How can I contact Abdul Basit?',
  'Contact Haroon': 'How can I contact Haroon Iqbal?',
  'Our team': 'Who is your management team?',
  'About us': 'Tell me about Reve Stitching',
  'Our clients': 'What brands do you work with?',
  'Visit contact page': '__LINK__/contact/',
  'T-shirt details': 'Tell me about your t-shirts',
  'Polo details': 'Tell me about your polo shirts',
  'Hoodie details': 'Tell me about your hoodies',
  'Jogger details': 'Tell me about your joggers',
  'Sweatshirt details': 'Tell me about your sweatshirts',
  'Ladies wear': 'Tell me about ladies wear collection',
  'Kids wear': 'Tell me about kids wear range',
  'Custom fabric': 'Can you develop custom fabrics?',
  'Fleece details': 'Tell me about terry fleece fabric',
  'Sample request': 'Do you provide samples before bulk?',
  'Payment terms': 'What are your payment terms?',
  'Shipping details': 'What are your shipping options?',
  'Order process': 'How does the ordering process work?',
  'Printing details': 'What printing options do you offer?',
  'Embroidery details': 'What embroidery services do you offer?',
  'Factory tour': 'Can I visit your factory?',
  'Location details': 'Where are you located?',
  'Send requirements': 'How do I share my requirements?',
  'Sustainability': 'Tell me about your sustainability efforts',
  'Capacity details': 'What is your production capacity?',
  'ERP system': 'Do you have an ERP system?',
};

    // ━━━ Default Quick Replies ━━━
const defaultQuickReplies = [
  { label: '📦 Product Range', value: 'What products do you manufacture?' },
  { label: '📋 MOQ Details', value: 'What is your minimum order quantity?' },
  { label: '💰 Get a Quote', value: 'I want to get a price quote' },
  { label: '🏭 Our Team', value: 'Who is your management team?' },
];

    // ━━━ Storage Helpers ━━━
    interface ChatMsg {
      text: string;
      sender: 'bot' | 'user' | 'admin' | 'system';
      time: string;
    }

    function ss(key: string, val?: string): string | null {
      try {
        if (val !== undefined) { sessionStorage.setItem(key, val); return val; }
        return sessionStorage.getItem(key);
      } catch { return null; }
    }

    function getMode(): 'bot' | 'live' { return (ss(SK.mode) as 'bot' | 'live') || 'bot'; }
    function setMode(m: 'bot' | 'live') { ss(SK.mode, m); }
    function getSessionId(): string | null { return ss(SK.sessionId); }
    function getVisitorToken(): string {
      let t = ss(SK.visitorToken);
      if (!t) { t = crypto.randomUUID(); ss(SK.visitorToken, t); }
      return t;
    }

    function saveMsg(text: string, sender: ChatMsg['sender']) {
      try {
        const h: ChatMsg[] = JSON.parse(ss(SK.messages) || '[]');
        h.push({ text, sender, time: formatTime() });
        ss(SK.messages, JSON.stringify(h));
      } catch {}
    }

    function getMsgHistory(): ChatMsg[] {
      try { return JSON.parse(ss(SK.messages) || '[]'); } catch { return []; }
    }

    // ━━━ Formatters ━━━
    function formatTime(): string {
      return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    function escapeHtml(s: string): string {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }
    function formatMessage(text: string): string {
      // C-007 hotfix: escape input first, then apply markdown transforms
      const escaped = escapeHtml(text);
      return escaped
        .replace(/\*\*(.*?)\*\*/g, '<strong class="font-semibold">$1</strong>')
        .replace(/\[(.*?)\]\((https?:[^)]+)\)/g, '<a href="$2" class="text-green-600 dark:text-green-400 underline hover:text-green-700 dark:hover:text-green-300">$1</a>')
        .replace(/\n/g, '<br/>');
    }

    // ━━━ Render Message ━━━
    function renderMessage(text: string, sender: ChatMsg['sender'], time?: string): void {
      if (!messages) return;
      const t = time || formatTime();
      const div = document.createElement('div');

      if (sender === 'system') {
        div.className = 'chat-msg flex justify-center';
        div.innerHTML = `<div class="px-4 py-2 bg-zinc-100 dark:bg-zinc-800 rounded-full text-xs text-zinc-500 dark:text-zinc-400">${formatMessage(text)}</div>`;
      } else if (sender === 'user') {
        div.className = 'chat-msg flex justify-end';
        div.innerHTML = `
          <div class="max-w-[80%]">
            <div class="bg-green-600 dark:bg-green-500 text-white dark:text-zinc-950 rounded-2xl rounded-tr-md px-4 py-3 text-sm leading-relaxed">${formatMessage(text)}</div>
            <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1 block text-right pr-1">${t}</span>
          </div>`;
      } else {
        // bot or admin
        const icon = sender === 'admin' ? adminIconSvg : botIconSvg;
        const iconBg = sender === 'admin' ? 'bg-green-100 dark:bg-green-900/30' : 'bg-green-600/10 dark:bg-green-500/10';
        div.className = 'chat-msg flex justify-start';
        div.innerHTML = `
          <div class="flex gap-2.5 max-w-[85%]">
            <div class="w-7 h-7 rounded-full ${iconBg} flex items-center justify-center shrink-0 mt-1">${icon}</div>
            <div>
              ${sender === 'admin' ? '<span class="text-[10px] text-green-600 dark:text-green-400 font-medium mb-0.5 block">Team Member</span>' : ''}
              <div class="bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-200 rounded-2xl rounded-tl-md px-4 py-3 text-sm leading-relaxed">${formatMessage(text)}</div>
              <span class="text-[10px] text-zinc-400 dark:text-zinc-500 mt-1 block pl-1">${t}</span>
            </div>
          </div>`;
      }

      messages.appendChild(div);
    }

    function addMessage(text: string, sender: ChatMsg['sender']): void {
      renderMessage(text, sender);
      saveMsg(text, sender);
      if (messages) messages.scrollTop = messages.scrollHeight;
    }

    // ━━━ Typing Indicator ━━━
    function showTyping(): void {
      if (!messages) return;
      const div = document.createElement('div');
      div.id = 'typing-indicator';
      div.className = 'chat-msg flex justify-start';
      div.innerHTML = `
        <div class="flex gap-2.5">
          <div class="w-7 h-7 rounded-full bg-green-600/10 dark:bg-green-500/10 flex items-center justify-center shrink-0 mt-1">${botIconSvg}</div>
          <div class="bg-zinc-100 dark:bg-zinc-800 rounded-2xl rounded-tl-md px-4 py-3 flex items-center gap-1.5">
            <div class="w-2 h-2 bg-zinc-400 dark:bg-zinc-500 rounded-full typing-dot"></div>
            <div class="w-2 h-2 bg-zinc-400 dark:bg-zinc-500 rounded-full typing-dot"></div>
            <div class="w-2 h-2 bg-zinc-400 dark:bg-zinc-500 rounded-full typing-dot"></div>
          </div>
        </div>`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    function hideTyping(): void {
      document.getElementById('typing-indicator')?.remove();
    }

    // ━━━ Quick Replies — uses CSS classes, NOT inline styles ━━━
    function showQuickReplies(replies?: string[]): void {
      if (!quickContainer) return;
      quickContainer.innerHTML = '';
      const items = replies
        ? replies.map(r => ({ label: r, value: quickReplyMap[r] || r }))
        : defaultQuickReplies;

      items.forEach(item => {
        if (item.value?.startsWith('__LINK__')) {
          const a = document.createElement('a');
          a.href = item.value.replace('__LINK__', '');
          a.className = 'inline-flex items-center gap-1 px-3 py-2 border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 rounded-full text-xs font-medium transition-all duration-200 cursor-pointer hover:bg-green-600 dark:hover:bg-green-500 hover:text-white dark:hover:text-zinc-950 hover:border-green-600 dark:hover:border-green-500';
          a.textContent = `🔗 ${item.label}`;
          quickContainer.appendChild(a);
          return;
        }
        const btn = document.createElement('button');
        btn.className = 'px-3 py-2 border border-zinc-200 dark:border-zinc-700 bg-white dark:bg-zinc-800 text-zinc-600 dark:text-zinc-300 rounded-full text-xs font-medium transition-all duration-200 cursor-pointer hover:bg-green-600 dark:hover:bg-green-500 hover:text-white dark:hover:text-zinc-950 hover:border-green-600 dark:hover:border-green-500';
        btn.textContent = item.label;
        btn.addEventListener('click', () => void handleUserMessage(item.value || item.label));
        quickContainer.appendChild(btn);
      });
    }

    function isHumanRequest(message: string): boolean {
      return /\b(talk|speak|connect)\s+(to|with)\s+(a\s+)?(human|person|representative|agent)\b|\bhuman\s+(representative|agent)\b/i.test(message);
    }

    // ━━━ Live Chat: Create Session ━━━
    async function requestHuman(): Promise<void> {
      if (getMode() === 'live' || document.getElementById('live-connect-btn')) return;

      requestSequence += 1;
      hideTyping();
      setSending(false);
      addMessage("I'm connecting you with a team member.", 'bot');

      if (quickContainer) {
        quickContainer.innerHTML = `
          <div class="w-full space-y-2 p-2">
            <p class="text-xs text-zinc-500 dark:text-zinc-400">Optional: share your info so we can assist you better</p>
            <input id="live-name" type="text" placeholder="Your name" class="w-full px-3 py-2 border border-zinc-200 dark:border-zinc-700 rounded-lg text-xs focus:outline-none focus:border-green-600 dark:focus:border-green-500 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white" />
            <input id="live-email" type="email" placeholder="Your email" class="w-full px-3 py-2 border border-zinc-200 dark:border-zinc-700 rounded-lg text-xs focus:outline-none focus:border-green-600 dark:focus:border-green-500 bg-white dark:bg-zinc-800 text-zinc-900 dark:text-white" />
            <div class="flex gap-2">
              <button id="live-connect-btn" class="chat-quick-btn flex-1 !py-2 !px-3 bg-green-600 dark:bg-green-500 text-white dark:text-zinc-950 hover:bg-green-700 dark:hover:bg-green-400">Connect Now</button>
              <button id="live-skip-btn" class="chat-quick-btn !py-2 !px-3 border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-400 hover:bg-zinc-50 dark:hover:bg-zinc-800">Skip</button>
            </div>
          </div>`;

        document.getElementById('live-connect-btn')?.addEventListener('click', () => {
          const name = (document.getElementById('live-name') as HTMLInputElement)?.value;
          const email = (document.getElementById('live-email') as HTMLInputElement)?.value;
          createLiveSession(name, email);
        });

        document.getElementById('live-skip-btn')?.addEventListener('click', () => {
          createLiveSession();
        });
      }
    }

    async function createLiveSession(name?: string, email?: string): Promise<void> {
      const connectBtn = document.getElementById('live-connect-btn') as HTMLButtonElement | null;
      const skipBtn = document.getElementById('live-skip-btn') as HTMLButtonElement | null;
      if (connectBtn?.disabled || skipBtn?.disabled) return;
      if (connectBtn) connectBtn.disabled = true;
      if (skipBtn) skipBtn.disabled = true;
      if (quickContainer) quickContainer.innerHTML = '';

      const visitorToken = getVisitorToken();

      try {
        const res = await fetch('/api/chat/session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            visitorToken,
            visitorName: name || null,
            visitorEmail: email || null,
          }),
        });

        const data = await res.json();

        if (!res.ok) throw new Error(data.error);

        ss(SK.sessionId, data.sessionId);
        setMode('live');

        addMessage("You're now connected! 🟢 A team member will join this chat shortly.\n\nYou can start typing your questions — they'll see your messages when they connect.\n\n🕐 Typical response: Within a few minutes during business hours (Mon-Sat, 8AM-6PM PKT).", 'system');

        startPolling();
        startHeartbeat();

      } catch (e) {
        addMessage("Sorry, I couldn't connect you right now. Please try emailing us at **haroon@revestitching.com** instead.", 'bot');
        showQuickReplies(['Get a quote', 'Contact team']);
      }
    }

    // ━━━ Live Chat: Send Message ━━━
    async function sendLiveMessage(text: string): Promise<void> {
      addMessage(text, 'user');

      const sessionId = getSessionId();
      const visitorToken = getVisitorToken();

      if (!sessionId) return;

      try {
        await fetch('/api/chat/send', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ sessionId, visitorToken, message: text }),
        });
      } catch (e) {
        console.warn('Failed to send live message:', e);
      }
    }

    // ━━━ Live Chat: Poll for Admin Messages ━━━
    function startPolling(): void {
      if (pollInterval) return;

      const intervalId = setInterval(async () => {
        const sessionId = getSessionId();
        const visitorToken = getVisitorToken();
        if (!sessionId) return;

        try {
          const res = await fetch(
            `/api/chat/poll?session=${sessionId}&token=${visitorToken}&after=${encodeURIComponent(lastPollTimestamp)}`
          );
          const data = await res.json();

          if (data.messages && data.messages.length > 0) {
            data.messages.forEach((msg: any) => {
              if (seenMessageIds.has(msg.id)) return;
              seenMessageIds.add(msg.id);

              lastPollTimestamp = msg.created_at;

              renderMessage(msg.message, 'admin', new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }));
              if (messages) messages.scrollTop = messages.scrollHeight;

              try {
                const h: ChatMsg[] = JSON.parse(ss(SK.messages) || '[]');
                const alreadySaved = h.some(m => m.text === msg.message && m.sender === 'admin');
                if (!alreadySaved) {
                  h.push({ text: msg.message, sender: 'admin', time: new Date(msg.created_at).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) });
                  ss(SK.messages, JSON.stringify(h));
                }
              } catch {}
            });
          }

          if (data.sessionStatus === 'closed') {
            stopPolling();
            stopHeartbeat();
            addMessage("This chat session has ended. Thank you for chatting with us! 👋", 'system');
            setMode('bot');

            sessionStorage.removeItem(SK.sessionId);
            sessionStorage.removeItem(SK.messages);
            sessionStorage.removeItem(SK.hasOpened);
            sessionStorage.removeItem(SK.wasOpen);
            sessionStorage.removeItem(SK.mode);

            showQuickReplies(['Get a quote', 'Product range', 'Contact team']);
          }
        } catch (e) {
          console.warn('Poll error:', e);
        }
      }, 3000);
      pollInterval = intervalId;
      (window as any).__chatPollInterval = intervalId;
    }

    // ━━━ Heartbeat ━━━
    let heartbeatInterval: ReturnType<typeof setInterval> | null = null;

    function startHeartbeat(): void {
      if (heartbeatInterval) return;
      const hbId = setInterval(async () => {
        const sessionId = getSessionId();
        const visitorToken = getVisitorToken();
        if (!sessionId || getMode() !== 'live') {
          stopHeartbeat();
          return;
        }
        try {
          await fetch('/api/chat/heartbeat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sessionId, visitorToken }),
          });
        } catch {}
      }, 15000);
      heartbeatInterval = hbId;
      (window as any).__chatHeartbeatInterval = hbId;
    }

    function stopHeartbeat(): void {
      if (heartbeatInterval) { clearInterval(heartbeatInterval); heartbeatInterval = null; }
      if ((window as any).__chatHeartbeatInterval) { clearInterval((window as any).__chatHeartbeatInterval); (window as any).__chatHeartbeatInterval = null; }
    }

    function stopPolling(): void {
      if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
      if ((window as any).__chatPollInterval) { clearInterval((window as any).__chatPollInterval); (window as any).__chatPollInterval = null; }
    }

    // ━━━ Handle User Message ━━━
    async function handleUserMessage(text: string): Promise<void> {
      const mode = getMode();

      if (mode === 'live') {
        await sendLiveMessage(text);
        return;
      }

      const cleanText = text.trim().slice(0, 1_200);
      if (!cleanText || isSending) return;

      if (isHumanRequest(cleanText)) {
        addMessage(cleanText, 'user');
        await requestHuman();
        return;
      }

      const history = getMsgHistory()
        .filter((message) => message.sender === 'user' || message.sender === 'bot')
        .slice(-10)
        .map((message) => ({
          text: message.text.slice(0, 1_200),
          sender: message.sender,
        }));

      addMessage(cleanText, 'user');
      if (quickContainer) quickContainer.innerHTML = '';
      showTyping();
      setSending(true);
      const requestId = ++requestSequence;

      try {
        const res = await fetch('/api/chat/bot', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message: cleanText, history }),
        });
        const data = await res.json().catch(() => ({}));

        if (requestId !== requestSequence || getMode() !== 'bot') return;

        if (res.ok && data.available === true && typeof data.reply === 'string') {
          hideTyping();
          addMessage(data.reply, 'bot');
          showQuickReplies(getQuickRepliesForAIResponse(data.reply));
          return;
        }

        const unavailableMessage = data.reason === 'quota_exceeded'
          ? 'The virtual assistant has reached its temporary usage limit. Please try again shortly or talk to our team.'
          : data.reason === 'rate_limited'
            ? 'You are sending messages too quickly. Please wait a minute or talk to our team.'
            : "I'm having trouble connecting to the virtual assistant right now. You can try again in a moment or talk to our team.";

        hideTyping();
        addMessage(unavailableMessage, 'system');
        showQuickReplies(['Request human', 'Get a quote', 'Contact team']);
      } catch {
        if (requestId !== requestSequence || getMode() !== 'bot') return;
        hideTyping();
        addMessage("I'm having trouble connecting to the virtual assistant right now. You can try again in a moment or talk to our team.", 'system');
        showQuickReplies(['Request human', 'Get a quote', 'Contact team']);
      } finally {
        if (requestId === requestSequence) {
          hideTyping();
          setSending(false);
        }
      }
    }

    function getQuickRepliesForAIResponse(reply: string): string[] {
      const lower = reply.toLowerCase();
      const suggestions: string[] = [];

      if (lower.includes('product') || lower.includes('garment') || lower.includes('manufacture')) suggestions.push('Product range');
      if (lower.includes('moq') || lower.includes('minimum')) suggestions.push('MOQ details');
      if (lower.includes('price') || lower.includes('quote') || lower.includes('cost')) suggestions.push('Get a quote');
      if (lower.includes('quality') || lower.includes('aql') || lower.includes('inspection')) suggestions.push('Quality standards');
      if (lower.includes('certif') || lower.includes('sedex') || lower.includes('iso')) suggestions.push('Certifications');
      if (lower.includes('fabric') || lower.includes('cotton') || lower.includes('jersey')) suggestions.push('Fabric types');
      if (lower.includes('sample')) suggestions.push('Sample request');
      if (lower.includes('lead time') || lower.includes('delivery') || lower.includes('shipping')) suggestions.push('Lead time');

      if (suggestions.length < 2) suggestions.push('Get a quote');
      if (suggestions.length < 3) suggestions.push('Request human');
      if (suggestions.length < 4) suggestions.push('Product range');

      return [...new Set(suggestions)].slice(0, 4);
    }

    // ━━━ Restore History ━━━
    function restoreHistory(): void {
      if (!messages) return;
      const history = getMsgHistory();
      if (history.length === 0) return;

      messages.innerHTML = '';
      history.forEach(msg => renderMessage(msg.text, msg.sender, msg.time));
      messages.scrollTop = messages.scrollHeight;
      notification?.classList.add('hidden');
    }

    // ━━━ Open/Close Chat ━━━
    function openChat(): void {
      isOpen = true;
      ss(SK.wasOpen, 'true');
      chatWindow?.classList.remove('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none');
      chatWindow?.classList.add('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
      chatWindow?.setAttribute('aria-hidden', 'false');
      iconOpen?.classList.add('opacity-0', 'rotate-90', 'scale-0');
      iconClose?.classList.remove('opacity-0');
      iconClose?.classList.add('rotate-0', 'scale-100');
      notification?.classList.add('hidden');

      if (window.innerWidth <= 480 && toggle) {
        toggle.style.display = 'none';
      }

      if (!ss(SK.hasOpened)) {
        ss(SK.hasOpened, 'true');
        setTimeout(() => {
          addMessage("Hello! 👋 Welcome to **Reve Stitching**!\n\nI'm your virtual assistant. I can help you with:\n\n• Product information & MOQ\n• Pricing & quotes\n• Quality standards & certifications\n• Lead times & delivery\n\nHow can I help you today?", 'bot');
          showQuickReplies();
        }, 400);
      } else {
        if (getMode() !== 'live') {
          showQuickReplies();
        }
      }
      input?.focus();
    }

    function closeChat(): void {
      isOpen = false;
      ss(SK.wasOpen, 'false');
      chatWindow?.classList.add('opacity-0', 'scale-95', 'translate-y-4', 'pointer-events-none');
      chatWindow?.classList.remove('opacity-100', 'scale-100', 'translate-y-0', 'pointer-events-auto');
      chatWindow?.setAttribute('aria-hidden', 'true');
      iconOpen?.classList.remove('opacity-0', 'rotate-90', 'scale-0');
      iconClose?.classList.add('opacity-0');
      iconClose?.classList.remove('rotate-0', 'scale-100');

      if (toggle) {
        toggle.style.display = '';
      }
    }

    // ━━━ Init ━━━
    function initChat(): void {
      if (ss(SK.hasOpened) && getMsgHistory().length > 0) {
        restoreHistory();
        notification?.classList.add('hidden');

        if (getMode() === 'live' && getSessionId()) {
          startPolling();
          startHeartbeat();
        }

        if (ss(SK.wasOpen) === 'true') openChat();
      }
    }

    // ━━━ Event Listeners ━━━
    toggle?.addEventListener('click', () => { isOpen ? closeChat() : openChat(); });
    minimize?.addEventListener('click', closeChat);

    const resetBtn = document.getElementById('chat-reset-btn');
    resetBtn?.addEventListener('click', () => {
      if (!confirm('Start a new chat? This will clear your current conversation.')) return;

      stopPolling();
      stopHeartbeat();

      const sessionId = getSessionId();
      const visitorToken = getVisitorToken();
      if (sessionId && getMode() === 'live') {
        navigator.sendBeacon('/api/chat/close', JSON.stringify({
          sessionId,
          visitorToken,
        }));
      }

      sessionStorage.removeItem(SK.messages);
      sessionStorage.removeItem(SK.hasOpened);
      sessionStorage.removeItem(SK.wasOpen);
      sessionStorage.removeItem(SK.mode);
      sessionStorage.removeItem(SK.sessionId);
      sessionStorage.removeItem(SK.visitorToken);

      window.location.reload();
    });

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input?.value?.trim();
      if (!text || isSending) return;
      void handleUserMessage(text);
      if (input) {
        input.value = '';
        input.style.height = 'auto';
      }
    });

    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        form?.dispatchEvent(new Event('submit'));
      }
    });

    input?.addEventListener('input', () => {
      if (!input) return;
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 120) + 'px';
    });

    humanBtn?.addEventListener('click', () => {
      if (getMode() === 'bot') void requestHuman();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen) closeChat();
    });

    // ━━━ Close session on tab close ━━━
    window.addEventListener('beforeunload', () => {
      const sessionId = getSessionId();
      const visitorToken = getVisitorToken();
      if (sessionId && getMode() === 'live') {
        navigator.sendBeacon('/api/chat/close', JSON.stringify({
          sessionId,
          visitorToken,
        }));
      }
    });

    // ━━━ Boot ━━━
    initChat();

  });
</script>
