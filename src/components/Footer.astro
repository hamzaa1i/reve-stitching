---
import { categories } from '../lib/catalogue/policy';
---
<footer class="border-t border-zinc-800 bg-zinc-950 px-6 py-16 text-zinc-400" role="contentinfo"><div class="mx-auto grid max-w-7xl gap-12 sm:grid-cols-2 lg:grid-cols-4"><div><a href="/" class="font-serif text-2xl font-bold text-white">Reve <span class="text-green-400">Stitching</span></a><p class="mt-5 text-sm leading-relaxed">Knitted garment manufacturing in Faisalabad, Pakistan. Explore real samples and discuss your next collection.</p><a href="/contact/" class="mt-5 inline-block text-sm text-green-400">Contact our team →</a></div><nav aria-label="Footer company links"><h2 class="mb-5 text-sm font-semibold text-white">Company</h2><ul class="space-y-3 text-sm">{[['/about/','About us'],['/quality/','Quality'],['/sustainability/','Responsible sourcing'],['/clients/','Clients'],['/case-studies/','Selected work'],['/portal/dashboard','Client portal']].map(([href,label])=><li><a class="hover:text-white" href={href}>{label}</a></li>)}</ul></nav><nav aria-label="Footer product categories"><h2 class="mb-5 text-sm font-semibold text-white">The collection</h2><ul class="space-y-3 text-sm">{categories.map(c=><li><a class="hover:text-white" href={`/products/${c.slug}/`}>{c.name}</a></li>)}</ul></nav><div><h2 class="mb-5 text-sm font-semibold text-white">Start your project</h2><p class="text-sm leading-relaxed">Chak No. 196/R.B, Ghona Road,<br />Faisalabad (38000), Pakistan</p><a class="mt-4 block text-sm text-green-400" href="mailto:info@revestitching.com">info@revestitching.com</a><a class="mt-3 block text-sm text-green-400" href="/quote/">Request a tailored quotation →</a><a class="mt-3 block text-sm" href="/samples/">Sample development →</a></div></div><div class="mx-auto mt-14 flex max-w-7xl flex-wrap justify-between gap-4 border-t border-zinc-800 pt-6 text-xs"><p>© {new Date().getFullYear()} Reve Stitching (Pvt.) Ltd.</p><p>Designed & developed by <a class="text-zinc-300" href="https://hamzaalikhurram.com">Hamza Ali</a></p></div></footer>
