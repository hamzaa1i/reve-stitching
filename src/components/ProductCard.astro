---
import CatalogueImage from './CatalogueImage.astro';
import { enquiryUrl } from '../lib/catalogue/policy';
import type { products } from '../data/products';
interface Props { product: typeof products[number]; index?: number; }
const { product, index = 0 } = Astro.props;
---
<article class="category-card" data-category-card={product.slug}>
  <a class="category-image" href={`/products/${product.slug}/`} aria-label={`Explore ${product.name}`}>
    <CatalogueImage sample={product.representative!} sizes="(max-width: 599px) 90vw, (max-width: 1023px) 45vw, 30vw" />
    <span class="image-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="category-content">
    <p class="eyebrow">{product.samples.length} {product.samples.length === 1 ? 'sample view' : 'sample views'}</p>
    <h3><a href={`/products/${product.slug}/`}>{product.name}</a></h3>
    <p>{product.description}</p>
    <div class="card-links"><a href={`/products/${product.slug}/`}>Explore category <span aria-hidden="true">→</span></a><a href={enquiryUrl('quote', product.slug)}>Enquire</a></div>
  </div>
</article>
