---
interface Props {
  status: string;
}

const { status } = Astro.props;
const normalized = status.toLowerCase();
const styles: Record<string, string> = {
  new: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  unread: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  read: 'bg-slate-100 text-slate-700 ring-slate-500/20',
  reviewed: 'bg-amber-50 text-amber-700 ring-amber-600/20',
  quoted: 'bg-violet-50 text-violet-700 ring-violet-600/20',
  converted: 'bg-green-50 text-green-700 ring-green-600/20',
  rejected: 'bg-red-50 text-red-700 ring-red-600/20',
  pending: 'bg-amber-50 text-amber-700 ring-amber-600/20',
  processing: 'bg-blue-50 text-blue-700 ring-blue-600/20',
  shipped: 'bg-violet-50 text-violet-700 ring-violet-600/20',
  delivered: 'bg-green-50 text-green-700 ring-green-600/20',
  waiting: 'bg-amber-50 text-amber-700 ring-amber-600/20',
  active: 'bg-green-50 text-green-700 ring-green-600/20',
  closed: 'bg-slate-100 text-slate-600 ring-slate-500/20',
};
const label = normalized === 'new' ? 'Unread' : normalized.charAt(0).toUpperCase() + normalized.slice(1);
---

<span class:list={['inline-flex items-center rounded-md px-2 py-1 text-xs font-semibold ring-1 ring-inset', styles[normalized] || styles.closed]}>
  {label}
</span>
