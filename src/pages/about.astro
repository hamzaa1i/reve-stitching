---
import EditorialPage from '../components/EditorialPage.astro';
const team=[['Haroon Iqbal','Director — Operations','/images/team/director-haroon.jpg'],['Abdul Basit','Director — Client Relations','/images/team/director-basit.jpg'],['Ghulam Jilani','General Manager','/images/team/gm.jpg']];
const photos=[['/images/factory/cutting.webp','Fabric cutting at Reve Stitching'],['/images/factory/stitching.webp','Garment stitching at Reve Stitching'],['/images/factory/pattern-marking.webp','Pattern marking for garment development']];
---
<EditorialPage title="Reve Stitching, Faisalabad." eyebrow="About our company" description="A knitted garment manufacturer in Pakistan’s textile heartland. Our work brings together garment development, sample review and production coordination for brand collections.">
<section class="cat-section"><div class="cat-wrap cat-hero-grid"><div><p class="eyebrow">From the first reference</p><h2>The detail makes the garment.</h2><p class="mt-5 text-zinc-600 dark:text-zinc-300">Our sample portfolio includes tees, collared tops, hoodies, sweatshirts, casual bottoms and women’s knitted separates. A reference is the start of a conversation: fit, materials, artwork and finishing are reviewed for your own specification.</p><div class="cat-actions"><a class="cat-button" href="/products/">Explore our samples ↗</a></div></div><img src="/images/hero/about.webp" width="900" height="600" alt="Reve Stitching factory frontage" loading="eager" class="w-full" /></div></section>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">Inside Reve</p><h2>Where garments take shape.</h2></div><p>Factory photographs from our existing company portfolio. The process route and any specialist partner arrangements are confirmed for the proposed order.</p></div><div class="category-grid">{photos.map(([src,alt])=><figure><img src={src} alt={alt} width="800" height="600" loading="lazy" class="aspect-[4/3] w-full object-cover" /><figcaption class="mt-3 text-sm text-zinc-500 dark:text-zinc-400">{alt}</figcaption></figure>)}</div></div></section>
<section class="cat-section"><div class="cat-wrap"><p class="eyebrow">Our team</p><h2>People behind the process.</h2><div class="category-grid mt-8">{team.map(([name,role,src])=><article><img src={src} alt={name} width="400" height="450" loading="lazy" class="aspect-[4/5] w-full object-cover" /><h3 class="mt-5">{name}</h3><p class="text-sm text-zinc-500 dark:text-zinc-400">{role}</p></article>)}</div></div></section>
<section class="cat-section"><div class="cat-wrap"><h2>Clear requirements. Clear communication.</h2><div class="option-grid mt-8">{[['Specification-led development','Agree the sample, measurements and garment details before production.'],['Quality requirements','Discuss the buyer’s inspection plan and test requirements for the actual order.'],['Commercial review','Confirm materials, production minimums, price and timing against your brief.']].map(([title,text])=><article class="option-panel"><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>
</EditorialPage>
