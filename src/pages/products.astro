---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import CatalogueImage from '../components/CatalogueImage.astro';
import { products, fabrics } from '../data/products';
import { catalogueMedia } from '../data/catalogue-media';
import '../styles/catalogue.css';
export const prerender = true;
const hero = catalogueMedia.find(s => s.sourceId === 'A049')!;
const second = catalogueMedia.find(s => s.sourceId === 'A024')!;
const schema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: 'Knitted garment catalogue', url: new URL('/products/', Astro.site).href, mainEntity: { '@type': 'ItemList', itemListElement: products.map((p,i) => ({ '@type':'ListItem', position:i+1, name:p.name, url:new URL(`/products/${p.slug}/`,Astro.site).href })) } };
---
<Layout title="Product Catalogue" description="Explore real Reve Stitching garment samples: tees, rugby tops, hoodies, sweatshirts, bottoms, women's wear and kidswear. Request a tailored manufacturing quotation.">
<div class="catalogue">
<section class="cat-hero"><div class="cat-wrap cat-hero-grid">
  <div class="hero-copy"><p class="eyebrow">Reve Stitching · The garment collection</p><h1>Made with detail.<br /><em>Made for your brand.</em></h1><p>Real garments from our sample collection. Explore the shapes, finishes and possibilities behind your next production enquiry.</p><div class="cat-actions"><a class="cat-button" href="#collection">Explore the collection <span aria-hidden="true">↓</span></a><a class="cat-button secondary" href="/quote/">Request a quote</a></div></div>
  <div class="hero-photos"><figure><CatalogueImage sample={hero} priority sizes="(max-width: 699px) 50vw, 26vw" /><figcaption><span>Rugby-style tops</span><span>01 / Reve samples</span></figcaption></figure><figure><CatalogueImage sample={second} sizes="(max-width: 699px) 40vw, 21vw" /><figcaption><span>Everyday layers</span><span>02</span></figcaption></figure></div>
</div></section>
<div class="cat-wrap cat-band"><span>Knitted garment manufacturing</span><span>Faisalabad, Pakistan</span><span>Development to production</span></div>
<section class="cat-section" id="collection" aria-labelledby="collection-heading"><div class="cat-wrap">
  <div class="section-heading"><div><p class="eyebrow">Browse the range</p><h2 id="collection-heading">A collection of possibilities.</h2></div><p>Eight categories. A considered selection of actual sample views. Every enquiry starts with your own requirements.</p></div>
  <nav class="category-filters" aria-label="Filter garment categories"><a href="/products/#collection" data-filter="all" aria-current="true">All categories</a>{products.map(p => <a href={`/products/${p.slug}/`} data-filter={p.slug} aria-current="false">{p.shortName}</a>)}</nav>
  <p class="filter-count" data-filter-count role="status">8 categories · {catalogueMedia.length} selected sample views</p>
  <div class="category-grid">{products.map((product,index) => <ProductCard product={product} index={index} />)}</div>
  <noscript><p>Each category link opens its full sample collection.</p></noscript>
</div></section>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">Develop your own specification</p><h2>The garment is the starting point.</h2></div><p>The examples show completed samples. Materials, construction and branding for your order are reviewed separately.</p></div><div class="option-grid">{fabrics.map((f,i) => <article class="option-panel"><p class="eyebrow">0{i+1} / Manufacturing options</p><h3>{f.name}</h3><p>{f.desc}</p></article>)}</div></div></section>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">From reference to production</p><h2>Clear steps. Considered decisions.</h2></div></div><ol class="process-list">{[
['01','Share the brief','Send your tech pack, reference sample, intended quantities and delivery requirements.'],
['02','Develop the sample','Review fabric, measurements, construction and artwork before finalising the specification.'],
['03','Confirm the order','Agree pricing, production minimums, testing needs and a realistic schedule.'],
['04','Make & deliver','Coordinate production, agreed quality checks, packing and shipment against the confirmed order.']
].map(([n,title,body]) => <li><p class="eyebrow">{n}</p><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>
<section class="cat-section"><div class="cat-wrap cat-cta"><p class="eyebrow">Your next collection</p><h2>Bring us the brief.<br />We’ll work through the details.</h2><p>Share your intended garment, quantities and specification. Our team will review materials, minimums and timing for a tailored quotation.</p><div class="cat-actions"><a class="cat-button" href="/quote/">Request a quote <span aria-hidden="true">↗</span></a><a class="cat-button secondary" href="/samples/">Sample development</a><a href="/contact/">General enquiry →</a></div></div></section>
</div>
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>
<script>
function initCatalogueFilters() {
 const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter]'));
 const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category-card]'));
 if (!links.length || links[0].dataset.ready) return;
 links[0].dataset.ready = 'true';
 function apply() { const requested = new URL(location.href).searchParams.get('category'); const active = cards.some(c=>c.dataset.categoryCard===requested) ? requested : 'all';
  links.forEach(a=>a.setAttribute('aria-current',String(a.dataset.filter===active)));
  cards.forEach(c=>c.hidden=active!=='all'&&c.dataset.categoryCard!==active);
  const count=document.querySelector('[data-filter-count]'); if(count) count.textContent=active==='all'?'8 categories · explore the sample collections':'1 category selected · open the collection to see its samples';
 }
 links.forEach(a=>a.addEventListener('click',event=>{if(event.metaKey||event.ctrlKey||event.shiftKey||event.altKey)return;event.preventDefault();const url=new URL(location.href);if(a.dataset.filter==='all')url.searchParams.delete('category');else url.searchParams.set('category',a.dataset.filter!);url.hash='collection';history.pushState({},'',url);apply();}));
 window.addEventListener('popstate',apply); apply();
}
document.addEventListener('astro:page-load',initCatalogueFilters); initCatalogueFilters();
</script>
