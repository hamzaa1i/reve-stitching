---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { orders, orderStages } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const orderId = Astro.params.id!;

const db = getDb();

let order: typeof orders.$inferSelect | undefined;
let stages: typeof orderStages.$inferSelect[] = [];

try {
  order = await db.select().from(orders)
    .where(eq(orders.id, orderId))
    .get();

  if (order && order.clientId !== user.id && user.role !== 'admin') {
    order = undefined;
  }

  if (order) {
    stages = await db.select().from(orderStages)
      .where(eq(orderStages.orderId, order.id))
      .orderBy(desc(orderStages.createdAt))
      .all();
  }
} catch {}

if (!order) {
  return Astro.redirect('/portal/orders');
}

const allStages = [
  { key: 'confirmed', label: 'Confirmed', icon: 'M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { key: 'fabric_sourced', label: 'Fabric Sourced', icon: 'M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76M11.25 2.25L12 2.25' },
  { key: 'cutting', label: 'Cutting', icon: 'M7.848 8.25l1.536.887M7.848 8.25a3 3 0 11-5.196-3 3 3 0 015.196 3zm1.536.887a2.165 2.165 0 011.083 1.839c.005.351.054.695.14 1.024M9.384 9.137l2.077 1.199M7.848 15.75l1.536-.887m-1.536.887a3 3 0 11-5.196 3 3 3 0 015.196-3zm1.536-.887a2.165 2.165 0 001.083-1.838c.005-.352.054-.696.14-1.025m-1.223 2.863l2.077-1.199m0-3.328a4.323 4.323 0 012.068-1.379l5.325-1.628a4.5 4.5 0 012.48-.044l.803.215m-7.676 2.836a2.534 2.534 0 00-.965 1.695m7.676-2.836l3.326 3.326M3.312 8.837l3.326-3.326' },
  { key: 'stitching', label: 'Stitching', icon: 'M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5' },
  { key: 'qc', label: 'Quality Check', icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z' },
  { key: 'packing', label: 'Packing', icon: 'M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z' },
  { key: 'shipped', label: 'Shipped', icon: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-1.036-.84-1.875-1.875-1.875H19.5m-12.75 0H5.625c-1.036 0-1.875.84-1.875 1.875v1.5c0 .621.504 1.125 1.125 1.125h1.5m12.75-8.25H5.625m12.75 0v-4.5a1.875 1.875 0 00-1.875-1.875h-9.75A1.875 1.875 0 004.125 6v4.5m14.25 0h.375a.375.375 0 01.375.375v.375a.375.375 0 01-.375.375H4.5a.375.375 0 01-.375-.375v-.375c0-.207.168-.375.375-.375h14.25' },
  { key: 'delivered', label: 'Delivered', icon: 'M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z' },
];

const currentIndex = allStages.findIndex(s => s.key === order!.status);
---

<PortalLayout title={`Order ${order.poNumber}`} activePage="orders">
  <!-- Back -->
  <a href="/portal/orders" class="mb-6 inline-flex items-center gap-2 text-sm text-zinc-500 transition-colors hover:text-white">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
    Back to Orders
  </a>

  <!-- Order header -->
  <div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">{order.poNumber}</h1>
      <p class="mt-1 text-sm text-zinc-500">{order.productType} · {order.quantity?.toLocaleString()} pcs · {order.color || 'Standard'}</p>
    </div>
    {order.trackingUrl ? (
      <a href={order.trackingUrl} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-xl border border-green-500/30 bg-green-500/10 px-5 py-2.5 text-sm font-medium text-green-400 hover:bg-green-500/20 transition-colors">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
        Track Shipment
      </a>
    ) : order.trackingNumber ? (
      <div class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 bg-zinc-800 px-5 py-2.5 text-sm text-zinc-400">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-1.036-.84-1.875-1.875-1.875H19.5" /></svg>
        Tracking: {order.trackingNumber}
      </div>
    ) : null}
  </div>

  <!-- Production Tracker -->
  <div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900 p-6">
    <h2 class="mb-6 text-sm font-bold uppercase tracking-wider text-zinc-400">Production Progress</h2>
    <div class="relative">
      <div class="absolute left-5 top-0 h-full w-0.5 bg-zinc-800"></div>
      <div class="absolute left-5 top-0 w-0.5 bg-green-500 transition-all duration-500" style={`height: ${currentIndex >= 0 ? (currentIndex / (allStages.length - 1)) * 100 : 0}%`}></div>

      <div class="space-y-6">
        {allStages.map((stage, i) => {
          const isComplete = i < currentIndex;
          const isCurrent = i === currentIndex;
          const isFuture = i > currentIndex;

          return (
            <div class="relative flex items-start gap-4 pl-1">
              <div class={`relative z-10 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border-2 transition-all ${
                isComplete
                  ? 'border-green-500 bg-green-500 text-white'
                  : isCurrent
                    ? 'border-green-400 bg-green-400/10 text-green-400 ring-4 ring-green-400/20'
                    : 'border-zinc-700 bg-zinc-900 text-zinc-600'
              }`}>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={stage.icon} />
                </svg>
              </div>
              <div class="pt-1.5">
                <div class={`text-sm font-semibold ${isComplete ? 'text-green-400' : isCurrent ? 'text-white' : 'text-zinc-600'}`}>
                  {stage.label}
                </div>
                {isCurrent && (
                  <span class="mt-1 inline-block rounded-full bg-green-400/10 px-2 py-0.5 text-[10px] font-semibold text-green-400">In Progress</span>
                )}
                {isComplete && (
                  <span class="mt-1 inline-block rounded-full bg-green-500/10 px-2 py-0.5 text-[10px] font-semibold text-green-500">Complete</span>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <!-- Order details grid -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Order Details</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">PO Number</dt><dd class="text-sm font-medium text-white">{order.poNumber}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Product</dt><dd class="text-sm font-medium text-white">{order.productType}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Quantity</dt><dd class="text-sm font-medium text-white">{order.quantity?.toLocaleString()} pcs</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Color</dt><dd class="text-sm font-medium text-white">{order.color || '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Size Range</dt><dd class="text-sm font-medium text-white">{order.sizeRange || '—'}</dd></div>
      </dl>
    </div>

    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Pricing</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Unit Price</dt><dd class="text-sm font-medium text-white">{order.unitPrice ? `${order.unitPrice} ${order.currency}` : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Total</dt><dd class="text-sm font-bold text-green-400">{order.totalPrice ? `${order.totalPrice} ${order.currency}` : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Fabric</dt><dd class="text-sm font-medium text-white">{order.fabricDetails || '—'}</dd></div>
      </dl>
    </div>

    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Timeline</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Created</dt><dd class="text-sm font-medium text-white">{order.createdAt ? new Date(order.createdAt).toLocaleDateString() : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Est. Completion</dt><dd class="text-sm font-medium text-white">{order.estimatedCompletion ? new Date(order.estimatedCompletion).toLocaleDateString() : '—'}</dd></div>
        {order.trackingNumber && (
          <div class="flex justify-between"><dt class="text-sm text-zinc-400">Tracking</dt><dd class="text-sm font-medium text-white">{order.trackingNumber}</dd></div>
        )}
      </dl>
    </div>
  </div>

  <!-- Stage photos / timeline -->
  {stages.length > 0 && (
    <div class="mt-8">
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-zinc-400">Stage Updates</h2>
      <div class="space-y-3">
        {stages.map((stage) => (
          <div class="flex gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4">
            {stage.photoUrl && (
              <img src={stage.photoUrl} alt={stage.stage} class="h-20 w-20 rounded-lg object-cover shrink-0" />
            )}
            <div>
              <div class="text-sm font-semibold text-white">{stage.stage}</div>
              {stage.notes && <p class="mt-1 text-sm text-zinc-400">{stage.notes}</p>}
              <div class="mt-2 text-xs text-zinc-600">{stage.createdAt ? new Date(stage.createdAt).toLocaleString() : ''}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {order.notes && (
    <div class="mt-8 rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Notes</div>
      <p class="mt-2 text-sm text-zinc-300">{order.notes}</p>
    </div>
  )}
</PortalLayout>