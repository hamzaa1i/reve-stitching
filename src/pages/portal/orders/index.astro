---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { orders } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const db = getDb();

let userOrders: typeof orders.$inferSelect[] = [];
try {
  userOrders = await db.select().from(orders)
    .where(eq(orders.clientId, user.id))
    .orderBy(desc(orders.createdAt))
    .all();
} catch {}

const statusLabels: Record<string, string> = {
  confirmed: 'Confirmed', fabric_sourced: 'Fabric Sourced', cutting: 'Cutting',
  stitching: 'Stitching', qc: 'Quality Check', packing: 'Packing',
  shipped: 'Shipped', delivered: 'Delivered',
};
const statusColors: Record<string, string> = {
  confirmed: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  fabric_sourced: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  cutting: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  stitching: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  qc: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  packing: 'bg-pink-500/10 text-pink-400 border-pink-500/20',
  shipped: 'bg-green-500/10 text-green-400 border-green-500/20',
  delivered: 'bg-green-500/10 text-green-400 border-green-500/20',
};
---

<PortalLayout title="Orders" activePage="orders">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-white sm:text-2xl">Orders</h1>
      <p class="mt-1 text-sm text-zinc-500">Track your production orders in real time</p>
    </div>
    <a href="/quote" class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-green-500">
      + New Order
    </a>
  </div>

  {userOrders.length === 0 ? (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-16 text-center">
      <svg class="mx-auto mb-4 h-16 w-16 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
      <h3 class="text-lg font-bold text-white">No orders yet</h3>
      <p class="mt-2 text-sm text-zinc-500">When you place an order, it will appear here with real-time tracking.</p>
      <a href="/quote" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-green-600 px-6 py-3 text-sm font-bold text-white hover:bg-green-500">
        Request a Quote
      </a>
    </div>
  ) : (
    <div class="space-y-3">
      {userOrders.map((order) => (
        <a href={`/portal/orders/${order.id}`} class="group flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900 p-5 transition-all hover:border-zinc-700 hover:bg-zinc-800/50">
          <div class="flex items-center gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-500/10">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" /></svg>
            </div>
            <div>
              <div class="text-sm font-bold text-white group-hover:text-green-400 transition-colors">{order.poNumber}</div>
              <div class="mt-0.5 text-xs text-zinc-500">{order.productType} · {order.quantity?.toLocaleString()} pcs · {order.color || ''}</div>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="hidden sm:block text-right">
              <div class="text-sm font-medium text-white">{order.totalPrice ? `${order.totalPrice} ${order.currency}` : '—'}</div>
              <div class="text-xs text-zinc-500">{order.createdAt ? new Date(order.createdAt).toLocaleDateString() : ''}</div>
            </div>
            <span class={`rounded-full border px-3 py-1 text-[10px] font-semibold ${statusColors[order.status || 'confirmed'] || 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20'}`}>
              {statusLabels[order.status || 'confirmed'] || order.status}
            </span>
          </div>
        </a>
      ))}
    </div>
  )}
</PortalLayout>