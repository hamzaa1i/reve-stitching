---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { users } from '../../../db/schema';
import { desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (user?.role !== 'admin') {
  return Astro.redirect('/portal/dashboard');
}

const db = getDb();
let allUsers: typeof users.$inferSelect[] = [];
try {
  allUsers = await db.select().from(users).orderBy(desc(users.createdAt)).all();
} catch {}

const statusColors: Record<string, string> = {
  active: 'bg-green-500/10 text-green-400 border-green-500/20',
  pending: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
  suspended: 'bg-red-500/10 text-red-400 border-red-500/20',
};
---

<PortalLayout title="Manage Clients" activePage="admin-clients">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-white sm:text-2xl">Clients</h1>
      <p class="mt-1 text-sm text-zinc-500">{allUsers.filter(u => u.role === 'client').length} registered clients</p>
    </div>
  </div>

  {allUsers.length === 0 ? (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-16 text-center">
      <p class="text-sm text-zinc-500">No users found</p>
    </div>
  ) : (
    <div class="overflow-x-auto rounded-xl border border-zinc-800 bg-zinc-900">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-zinc-800">
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Name</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Company</th>
            <th class="hidden px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500 md:table-cell">Email</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Role</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Status</th>
            <th class="px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-500">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-800">
          {allUsers.map((u) => (
            <tr class="hover:bg-zinc-800/30 transition-colors">
              <td class="px-5 py-3.5">
                <div class="flex items-center gap-3">
                  <div class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-bold ${u.role === 'admin' ? 'bg-green-600/20 text-green-400' : 'bg-blue-500/10 text-blue-400'}`}>
                    {u.name?.charAt(0)?.toUpperCase() || 'U'}
                  </div>
                  <div class="text-sm font-medium text-white">{u.name}</div>
                </div>
              </td>
              <td class="px-5 py-3.5 text-sm text-zinc-400">{u.company || '—'}</td>
              <td class="hidden px-5 py-3.5 text-sm text-zinc-400 md:table-cell">{u.email}</td>
              <td class="px-5 py-3.5">
                <span class={`rounded-full px-2 py-0.5 text-[10px] font-semibold ${u.role === 'admin' ? 'bg-green-500/10 text-green-400' : 'bg-blue-500/10 text-blue-400'}`}>
                  {u.role}
                </span>
              </td>
              <td class="px-5 py-3.5">
                <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-semibold ${statusColors[u.status || 'pending'] || statusColors.pending}`}>
                  {u.status || 'pending'}
                </span>
              </td>
              <td class="px-5 py-3.5">
                {u.role === 'client' && (
                  <div class="flex gap-1">
                    {u.status !== 'active' && (
                      <button
                        data-user-id={u.id}
                        data-action="active"
                        class="admin-action-btn rounded-lg px-3 py-1.5 text-[11px] font-semibold bg-green-600/10 text-green-400 hover:bg-green-600/20 transition-colors"
                      >Activate</button>
                    )}
                    {u.status !== 'suspended' && (
                      <button
                        data-user-id={u.id}
                        data-action="suspended"
                        class="admin-action-btn rounded-lg px-3 py-1.5 text-[11px] font-semibold bg-red-500/10 text-red-400 hover:bg-red-500/20 transition-colors"
                      >Suspend</button>
                    )}
                  </div>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</PortalLayout>

<script is:inline>
  document.querySelectorAll('.admin-action-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const userId = btn.getAttribute('data-user-id');
      const action = btn.getAttribute('data-action');
      if (!userId || !action) return;

      btn.disabled = true;
      btn.textContent = '...';

      try {
        const res = await fetch(`/api/portal/admin/clients/${userId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: action }),
        });

        if (res.ok) {
          window.location.reload();
        } else {
          btn.disabled = false;
          btn.textContent = action === 'active' ? 'Activate' : 'Suspend';
          alert('Failed to update client');
        }
      } catch {
        btn.disabled = false;
        btn.textContent = action === 'active' ? 'Activate' : 'Suspend';
        alert('Network error');
      }
    });
  });
</script>