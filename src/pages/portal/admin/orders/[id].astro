---
import PortalLayout from '../../../../layouts/PortalLayout.astro';
import { getDb } from '../../../../db/index';
import { orders, orderStages, users } from '../../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user;
if (user?.role !== 'admin') {
  return Astro.redirect('/portal/dashboard');
}

const orderId = Astro.params.id!;
const db = getDb();

let order: typeof orders.$inferSelect | undefined;
let stages: typeof orderStages.$inferSelect[] = [];
let clientName = '';

try {
  order = await db.select().from(orders).where(eq(orders.id, orderId)).get();
  if (order) {
    stages = await db.select().from(orderStages).where(eq(orderStages.orderId, order.id)).orderBy(desc(orderStages.createdAt)).all();
    const client = await db.select({ name: users.name }).from(users).where(eq(users.id, order.clientId)).get();
    clientName = client?.name || 'Unknown';
  }
} catch {}

if (!order) {
  return Astro.redirect('/portal/admin/orders');
}

const allStages = [
  { key: 'confirmed', label: 'Confirmed' },
  { key: 'fabric_sourced', label: 'Fabric Sourced' },
  { key: 'cutting', label: 'Cutting' },
  { key: 'stitching', label: 'Stitching' },
  { key: 'qc', label: 'Quality Check' },
  { key: 'packing', label: 'Packing' },
  { key: 'shipped', label: 'Shipped' },
  { key: 'delivered', label: 'Delivered' },
];

const currentIndex = allStages.findIndex(s => s.key === order!.status);
const nextStage = currentIndex < allStages.length - 1 ? allStages[currentIndex + 1] : null;
---

<PortalLayout title={`Order ${order.poNumber}`} activePage="admin-orders">
  <a href="/portal/admin/orders" class="mb-6 inline-flex items-center gap-2 text-sm text-zinc-500 transition-colors hover:text-white">
    <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" /></svg>
    Back to Orders
  </a>

  <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <h1 class="text-2xl font-bold text-white">{order.poNumber}</h1>
      <p class="mt-1 text-sm text-zinc-500">{order.productType} · {order.quantity?.toLocaleString()} pcs · Client: <span class="text-zinc-300">{clientName}</span></p>
    </div>
    {nextStage && (
      <button
        id="admin-advance-btn"
        data-order-id={order.id}
        data-next-stage={nextStage.key}
        class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-green-500 transition-colors"
      >
        Advance to: {nextStage.label}
      </button>
    )}
    {!nextStage && (
      <span class="inline-flex items-center gap-2 rounded-xl border border-green-500/30 bg-green-500/10 px-5 py-2.5 text-sm font-bold text-green-400">
        ✓ Order Complete
      </span>
    )}
  </div>

  <!-- Stage update form -->
  <div id="admin-stage-panel" class="mb-6 hidden rounded-xl border border-green-500/20 bg-green-500/5 p-5">
    <h3 class="mb-3 text-sm font-bold text-white">Update: <span id="admin-stage-label" class="text-green-400"></span></h3>
    <div class="space-y-3">
      <div>
        <label class="mb-1.5 block text-sm font-medium text-zinc-300">Notes</label>
        <textarea id="admin-stage-notes" rows="2" placeholder="Optional update notes..." class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500 resize-none"></textarea>
      </div>
      <div>
        <label class="mb-1.5 block text-sm font-medium text-zinc-300">Photo URL</label>
        <input id="admin-stage-photo" placeholder="https://..." class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
      </div>
      <div id="admin-stage-error" class="hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400"></div>
      <div class="flex gap-3">
        <button id="admin-stage-submit" class="rounded-xl bg-green-600 px-6 py-2.5 text-sm font-bold text-white hover:bg-green-500 disabled:opacity-50">Confirm Update</button>
        <button id="admin-stage-cancel" class="rounded-xl border border-zinc-700 px-6 py-2.5 text-sm font-medium text-zinc-400 hover:bg-zinc-800 hover:text-white">Cancel</button>
      </div>
    </div>
  </div>

  <!-- Progress bar -->
  <div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900 p-6">
    <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-zinc-400">Progress</h2>
    <div class="flex items-center gap-1">
      {allStages.map((stage, i) => {
        const isComplete = i < currentIndex;
        const isCurrent = i === currentIndex;
        return (
          <div class="flex-1 flex flex-col items-center gap-2">
            <div class={`h-2 w-full rounded-full transition-all ${isComplete ? 'bg-green-500' : isCurrent ? 'bg-green-400' : 'bg-zinc-800'}`}></div>
            <span class={`text-[9px] font-semibold text-center leading-tight ${isComplete ? 'text-green-500' : isCurrent ? 'text-green-400' : 'text-zinc-600'}`}>
              {stage.label}
            </span>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Order details -->
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-8">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Order Info</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">PO</dt><dd class="text-sm font-medium text-white">{order.poNumber}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Product</dt><dd class="text-sm font-medium text-white">{order.productType}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Qty</dt><dd class="text-sm font-medium text-white">{order.quantity?.toLocaleString()}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Color</dt><dd class="text-sm font-medium text-white">{order.color || '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Size</dt><dd class="text-sm font-medium text-white">{order.sizeRange || '—'}</dd></div>
      </dl>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Pricing</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Unit</dt><dd class="text-sm font-medium text-white">{order.unitPrice ? `${order.unitPrice} ${order.currency}` : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Total</dt><dd class="text-sm font-bold text-green-400">{order.totalPrice ? `${order.totalPrice} ${order.currency}` : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Fabric</dt><dd class="text-sm font-medium text-white">{order.fabricDetails || '—'}</dd></div>
      </dl>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Timeline</div>
      <dl class="mt-3 space-y-2">
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Created</dt><dd class="text-sm font-medium text-white">{order.createdAt ? new Date(order.createdAt).toLocaleDateString() : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Est.</dt><dd class="text-sm font-medium text-white">{order.estimatedCompletion ? new Date(order.estimatedCompletion).toLocaleDateString() : '—'}</dd></div>
        <div class="flex justify-between"><dt class="text-sm text-zinc-400">Tracking</dt><dd class="text-sm font-medium text-white">{order.trackingNumber || '—'}</dd></div>
      </dl>
    </div>
  </div>

  <!-- Tracking info -->
  <div class="mb-8 rounded-xl border border-zinc-800 bg-zinc-900 p-5">
    <h3 class="mb-3 text-sm font-bold text-white">Update Tracking Info</h3>
    <div class="flex flex-col gap-3 sm:flex-row">
      <input id="admin-tracking-num" value={order.trackingNumber || ''} placeholder="Tracking number" class="flex-1 rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
      <input id="admin-tracking-url" value={order.trackingUrl || ''} placeholder="Tracking URL" class="flex-1 rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-2.5 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
      <button id="admin-save-tracking" data-order-id={order.id} class="rounded-xl bg-zinc-700 px-5 py-2.5 text-sm font-bold text-white hover:bg-zinc-600 transition-colors">Save</button>
    </div>
  </div>

  <!-- Stage history -->
  {stages.length > 0 && (
    <div>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-zinc-400">Stage History</h2>
      <div class="space-y-3">
        {stages.map((stage) => (
          <div class="flex gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4">
            {stage.photoUrl && (
              <img src={stage.photoUrl} alt={stage.stage} class="h-20 w-20 rounded-lg object-cover shrink-0" />
            )}
            <div>
              <div class="text-sm font-semibold text-white">{stage.stage}</div>
              {stage.notes && <p class="mt-1 text-sm text-zinc-400">{stage.notes}</p>}
              <div class="mt-2 text-xs text-zinc-600">{stage.createdAt ? new Date(stage.createdAt).toLocaleString() : ''}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  {order.notes && (
    <div class="mt-8 rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Notes</div>
      <p class="mt-2 text-sm text-zinc-300">{order.notes}</p>
    </div>
  )}
</PortalLayout>

<script is:inline>
  (function() {
    var advanceBtn = document.getElementById('admin-advance-btn');
    var stagePanel = document.getElementById('admin-stage-panel');
    var stageLabel = document.getElementById('admin-stage-label');
    var stageNotes = document.getElementById('admin-stage-notes');
    var stagePhoto = document.getElementById('admin-stage-photo');
    var stageSubmit = document.getElementById('admin-stage-submit');
    var stageCancel = document.getElementById('admin-stage-cancel');
    var stageError = document.getElementById('admin-stage-error');

    var currentOrderId = '';
    var currentNextStage = '';

    if (advanceBtn) {
      advanceBtn.addEventListener('click', function() {
        currentOrderId = advanceBtn.getAttribute('data-order-id');
        currentNextStage = advanceBtn.getAttribute('data-next-stage');
        stageLabel.textContent = currentNextStage;
        stagePanel.classList.remove('hidden');
        stageNotes.value = '';
        stagePhoto.value = '';
        stageError.classList.add('hidden');
        advanceBtn.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }

    if (stageCancel) {
      stageCancel.addEventListener('click', function() {
        stagePanel.classList.add('hidden');
      });
    }

    if (stageSubmit) {
      stageSubmit.addEventListener('click', function() {
        stageSubmit.disabled = true;
        stageSubmit.textContent = 'Updating...';
        stageError.classList.add('hidden');

        fetch('/api/portal/admin/orders/' + currentOrderId + '/stage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            stage: currentNextStage,
            notes: stageNotes.value,
            photoUrl: stagePhoto.value,
          }),
        }).then(function(res) {
          if (res.ok) {
            window.location.reload();
          } else {
            return res.json().then(function(data) {
              stageError.textContent = data.error || 'Failed to update';
              stageError.classList.remove('hidden');
              stageSubmit.disabled = false;
              stageSubmit.textContent = 'Confirm Update';
            });
          }
        }).catch(function() {
          stageError.textContent = 'Network error';
          stageError.classList.remove('hidden');
          stageSubmit.disabled = false;
          stageSubmit.textContent = 'Confirm Update';
        });
      });
    }

    // Tracking
    var saveTracking = document.getElementById('admin-save-tracking');
    if (saveTracking) {
      saveTracking.addEventListener('click', function() {
        var orderId = saveTracking.getAttribute('data-order-id');
        var trackingNumber = document.getElementById('admin-tracking-num').value;
        var trackingUrl = document.getElementById('admin-tracking-url').value;
        saveTracking.disabled = true;
        saveTracking.textContent = 'Saving...';

        fetch('/api/portal/admin/orders/' + orderId, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ trackingNumber: trackingNumber, trackingUrl: trackingUrl }),
        }).then(function() {
          saveTracking.textContent = 'Saved ✓';
          setTimeout(function() { saveTracking.disabled = false; saveTracking.textContent = 'Save'; }, 2000);
        }).catch(function() {
          saveTracking.disabled = false;
          saveTracking.textContent = 'Save';
        });
      });
    }
  })();
</script> 