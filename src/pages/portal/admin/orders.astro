---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { orders, users } from '../../../db/schema';
import { desc, eq } from 'drizzle-orm';

const user = Astro.locals.user;
if (user?.role !== 'admin') {
  return Astro.redirect('/portal/dashboard');
}

const db = getDb();
let allOrders: typeof orders.$inferSelect[] = [];
let clientMap: Record<string, string> = {};

try {
  allOrders = await db.select().from(orders).orderBy(desc(orders.createdAt)).all();
  const allUsers = await db.select({ id: users.id, name: users.name }).from(users).all();
  allUsers.forEach(u => { clientMap[u.id] = u.name; });
} catch {}

const statusLabels: Record<string, string> = {
  confirmed: 'Confirmed', fabric_sourced: 'Fabric Sourced', cutting: 'Cutting',
  stitching: 'Stitching', qc: 'Quality Check', packing: 'Packing',
  shipped: 'Shipped', delivered: 'Delivered',
};
const statusColors: Record<string, string> = {
  confirmed: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  fabric_sourced: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  cutting: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  stitching: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  qc: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  packing: 'bg-pink-500/10 text-pink-400 border-pink-500/20',
  shipped: 'bg-green-500/10 text-green-400 border-green-500/20',
  delivered: 'bg-green-500/10 text-green-400 border-green-500/20',
};

const allClients = await db.select({ id: users.id, name: users.name, company: users.company }).from(users).where(eq(users.role, 'client')).all();
---

<PortalLayout title="Manage Orders" activePage="admin-orders">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-white sm:text-2xl">Orders</h1>
      <p class="mt-1 text-sm text-zinc-500">{allOrders.length} total orders</p>
    </div>
    <button id="admin-create-order-btn" class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-green-500">
      + Create Order
    </button>
  </div>

  <!-- Create Order Modal -->
  <div id="admin-create-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="w-full max-w-lg rounded-2xl border border-zinc-800 bg-zinc-900 p-6 max-h-[90vh] overflow-y-auto">
      <div class="mb-5 flex items-center justify-between">
        <h2 class="text-lg font-bold text-white">Create Order</h2>
        <button id="admin-close-modal" class="flex h-8 w-8 items-center justify-center rounded-lg text-zinc-500 hover:bg-zinc-800 hover:text-white">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
      </div>
      <form id="admin-create-form" class="space-y-4">
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Client *</label>
          <select name="clientId" required class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white outline-none focus:border-green-500">
            <option value="">Select client...</option>
            {allClients.map(c => (
              <option value={c.id}>{c.name}{c.company ? ` — ${c.company}` : ''}</option>
            ))}
          </select>
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">PO Number *</label>
          <input name="poNumber" required placeholder="PO-2025-001" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Product Type *</label>
            <input name="productType" required placeholder="T-Shirts" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Quantity *</label>
            <input name="quantity" type="number" required placeholder="5000" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Unit Price</label>
            <input name="unitPrice" placeholder="3.50" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Total Price</label>
            <input name="totalPrice" placeholder="17500" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Color</label>
            <input name="color" placeholder="Navy Blue" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
          <div>
            <label class="mb-1.5 block text-sm font-medium text-zinc-300">Size Range</label>
            <input name="sizeRange" placeholder="S-XXL" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
          </div>
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Fabric Details</label>
          <input name="fabricDetails" placeholder="180gsm 100% Organic Cotton" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Est. Completion</label>
          <input name="estimatedCompletion" type="date" class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white outline-none focus:border-green-500" />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Notes</label>
          <textarea name="notes" rows="2" placeholder="Any special instructions..." class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500 resize-none"></textarea>
        </div>
        <div id="admin-create-error" class="hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400"></div>
        <button type="submit" id="admin-create-submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-green-600 py-3.5 text-sm font-bold text-white hover:bg-green-500 disabled:opacity-50">
          Create Order
        </button>
      </form>
    </div>
  </div>

  <!-- Orders list -->
  {allOrders.length === 0 ? (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-16 text-center">
      <p class="text-sm text-zinc-500">No orders yet. Create your first order above.</p>
    </div>
  ) : (
    <div class="space-y-3">
      {allOrders.map((order) => (
        <a href={`/portal/admin/orders/${order.id}`} class="group flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900 p-5 transition-all hover:border-zinc-700 hover:bg-zinc-800/50">
          <div class="flex items-center gap-4">
            <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-green-500/10">
              <svg class="h-5 w-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z" /></svg>
            </div>
            <div>
              <div class="text-sm font-bold text-white group-hover:text-green-400 transition-colors">{order.poNumber}</div>
              <div class="mt-0.5 text-xs text-zinc-500">{order.productType} · {order.quantity?.toLocaleString()} pcs · <span class="text-zinc-400">{clientMap[order.clientId] || 'Unknown'}</span></div>
            </div>
          </div>
          <span class={`rounded-full border px-3 py-1 text-[10px] font-semibold ${statusColors[order.status || 'confirmed'] || 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20'}`}>
            {statusLabels[order.status || 'confirmed'] || order.status}
          </span>
        </a>
      ))}
    </div>
  )}
</PortalLayout>

<script is:inline>
  (function() {
    var createBtn = document.getElementById('admin-create-order-btn');
    var modal = document.getElementById('admin-create-modal');
    var closeModal = document.getElementById('admin-close-modal');
    var form = document.getElementById('admin-create-form');
    var errorEl = document.getElementById('admin-create-error');
    var submitBtn = document.getElementById('admin-create-submit');

    if (createBtn && modal) {
      createBtn.addEventListener('click', function() {
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    }
    if (closeModal && modal) {
      closeModal.addEventListener('click', function() {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      });
    }
    if (modal) {
      modal.addEventListener('click', function(e) {
        if (e.target === modal) {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
        }
      });
    }

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        errorEl.classList.add('hidden');
        submitBtn.disabled = true;
        submitBtn.textContent = 'Creating...';

        var fd = new FormData(form);
        var body = Object.fromEntries(fd.entries());
        body.quantity = Number(body.quantity);
        if (body.estimatedCompletion) body.estimatedCompletion = new Date(body.estimatedCompletion).toISOString();

        fetch('/api/portal/admin/orders', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        }).then(function(res) {
          return res.json().then(function(data) {
            if (res.ok) {
              window.location.reload();
            } else {
              errorEl.textContent = data.error || 'Failed to create order';
              errorEl.classList.remove('hidden');
              submitBtn.disabled = false;
              submitBtn.textContent = 'Create Order';
            }
          });
        }).catch(function() {
          errorEl.textContent = 'Network error';
          errorEl.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Create Order';
        });
      });
    }
  })();
</script>