---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { documents } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const db = getDb();

let docs: typeof documents.$inferSelect[] = [];
try {
  docs = await db.select().from(documents)
    .where(eq(documents.clientId, user.id))
    .orderBy(desc(documents.createdAt))
    .all();
} catch {}

const typeIcons: Record<string, string> = {
  invoice: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  packing_list: 'M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z',
  quality_report: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
  certificate: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
  tech_pack: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
  shipping: 'M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-1.036-.84-1.875-1.875-1.875H19.5m-12.75 0H5.625c-1.036 0-1.875.84-1.875 1.875v1.5c0 .621.504 1.125 1.125 1.125h1.5m12.75-8.25H5.625m12.75 0v-4.5a1.875 1.875 0 00-1.875-1.875h-9.75A1.875 1.875 0 004.125 6v4.5m14.25 0h.375a.375.375 0 01.375.375v.375a.375.375 0 01-.375.375H4.5a.375.375 0 01-.375-.375v-.375c0-.207.168-.375.375-.375h14.25',
  other: 'M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z',
};
const typeLabels: Record<string, string> = {
  invoice: 'Invoice', packing_list: 'Packing List', quality_report: 'Quality Report',
  certificate: 'Certificate', tech_pack: 'Tech Pack', shipping: 'Shipping Doc', other: 'Document',
};
---

<PortalLayout title="Documents" activePage="documents">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-white sm:text-2xl">Documents</h1>
    <p class="mt-1 text-sm text-zinc-500">Invoices, quality reports, certificates, and shipping documents</p>
  </div>

  {docs.length === 0 ? (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-16 text-center">
      <svg class="mx-auto mb-4 h-16 w-16 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
      <h3 class="text-lg font-bold text-white">No documents yet</h3>
      <p class="mt-2 text-sm text-zinc-500">Documents will be uploaded here as your orders progress.</p>
    </div>
  ) : (
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {docs.map((doc) => (
        <a href={doc.fileUrl} target="_blank" class="group flex items-start gap-4 rounded-xl border border-zinc-800 bg-zinc-900 p-4 transition-all hover:border-zinc-700 hover:bg-zinc-800/50">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-green-500/10">
            <svg class="h-5 w-5 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={typeIcons[doc.type || 'other'] || typeIcons.other} />
          </div>
          <div class="min-w-0 flex-1">
            <div class="truncate text-sm font-medium text-white group-hover:text-green-400 transition-colors">{doc.filename}</div>
            <div class="mt-0.5 text-xs text-zinc-500">{typeLabels[doc.type || 'other'] || 'Document'}</div>
            <div class="mt-1 text-xs text-zinc-600">{doc.createdAt ? new Date(doc.createdAt).toLocaleDateString() : ''}</div>
          </div>
        </a>
      ))}
    </div>
  )}
</PortalLayout>