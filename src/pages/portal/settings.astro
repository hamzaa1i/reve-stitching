---
import PortalLayout from '../../layouts/PortalLayout.astro';

const user = Astro.locals.user!;
---

<PortalLayout title="Settings" activePage="settings">
  <div class="mb-6">
    <h1 class="text-xl font-bold text-white sm:text-2xl">Settings</h1>
    <p class="mt-1 text-sm text-zinc-500">Manage your account preferences</p>
  </div>

  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Change Password -->
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
      <h2 class="mb-1 text-sm font-bold text-white">Change Password</h2>
      <p class="mb-5 text-xs text-zinc-500">Use a strong password with letters, numbers, and symbols.</p>

      <form id="password-form" class="space-y-4">
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Current Password</label>
          <input
            type="password"
            id="current-password"
            required
            class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20"
          />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">New Password</label>
          <input
            type="password"
            id="new-password"
            required
            minlength="8"
            class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20"
          />
        </div>
        <div>
          <label class="mb-1.5 block text-sm font-medium text-zinc-300">Confirm New Password</label>
          <input
            type="password"
            id="confirm-password"
            required
            minlength="8"
            class="w-full rounded-xl border border-zinc-700 bg-zinc-800 px-4 py-3 text-sm text-white placeholder-zinc-500 outline-none focus:border-green-500 focus:ring-2 focus:ring-green-500/20"
          />
        </div>
        <div id="pw-error" class="hidden rounded-xl border border-red-500/20 bg-red-500/10 px-4 py-3 text-sm text-red-400"></div>
        <div id="pw-success" class="hidden rounded-xl border border-green-500/20 bg-green-500/10 px-4 py-3 text-sm text-green-400">Password updated successfully.</div>
        <button type="submit" id="pw-submit" class="w-full rounded-xl bg-green-600 py-3 text-sm font-bold text-white hover:bg-green-500 disabled:opacity-50 transition-colors">
          Update Password
        </button>
      </form>
    </div>

    <!-- Account Info -->
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-6">
      <h2 class="mb-1 text-sm font-bold text-white">Account Info</h2>
      <p class="mb-5 text-xs text-zinc-500">Your account details. Contact us to update name or email.</p>
      <dl class="space-y-4">
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-zinc-500">Name</dt>
          <dd class="mt-1 text-sm text-white">{user.name}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-zinc-500">Email</dt>
          <dd class="mt-1 text-sm text-white">{user.email}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-zinc-500">Company</dt>
          <dd class="mt-1 text-sm text-white">{user.company || '—'}</dd>
        </div>
        <div>
          <dt class="text-xs font-medium uppercase tracking-wider text-zinc-500">Role</dt>
          <dd class="mt-1">
            <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${user.role === 'admin' ? 'bg-green-500/10 text-green-400' : 'bg-blue-500/10 text-blue-400'}`}>
              {user.role}
            </span>
          </dd>
        </div>
      </dl>
    </div>
  </div>
</PortalLayout>

<script is:inline>
  (function() {
    var form = document.getElementById('password-form');
    var errorEl = document.getElementById('pw-error');
    var successEl = document.getElementById('pw-success');
    var submitBtn = document.getElementById('pw-submit');

    if (!form) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      errorEl.classList.add('hidden');
      successEl.classList.add('hidden');

      var current = document.getElementById('current-password').value;
      var newPw = document.getElementById('new-password').value;
      var confirm = document.getElementById('confirm-password').value;

      if (newPw !== confirm) {
        errorEl.textContent = 'New passwords do not match.';
        errorEl.classList.remove('hidden');
        return;
      }

      if (newPw.length < 8) {
        errorEl.textContent = 'Password must be at least 8 characters.';
        errorEl.classList.remove('hidden');
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = 'Updating...';

      fetch('/api/portal/settings/password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword: current, newPassword: newPw }),
      }).then(function(res) {
        return res.json().then(function(data) {
          if (res.ok) {
            successEl.classList.remove('hidden');
            form.reset();
          } else {
            errorEl.textContent = data.error || 'Failed to update password.';
            errorEl.classList.remove('hidden');
          }
          submitBtn.disabled = false;
          submitBtn.textContent = 'Update Password';
        });
      }).catch(function() {
        errorEl.textContent = 'Network error. Please try again.';
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Update Password';
      });
    });
  })();
</script>