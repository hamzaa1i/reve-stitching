---
import PortalLayout from '../../../layouts/PortalLayout.astro';
import { getDb } from '../../../db/index';
import { quotes } from '../../../db/schema';
import { eq, desc } from 'drizzle-orm';

const user = Astro.locals.user!;
const db = getDb();

let userQuotes: typeof quotes.$inferSelect[] = [];
try {
  userQuotes = await db.select().from(quotes)
    .where(eq(quotes.clientId, user.id))
    .orderBy(desc(quotes.createdAt))
    .all();
} catch {}

const statusColors: Record<string, string> = {
  pending: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
  sent: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  approved: 'bg-green-500/10 text-green-400 border-green-500/20',
  rejected: 'bg-red-500/10 text-red-400 border-red-500/20',
  expired: 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20',
};
---

<PortalLayout title="Quotes" activePage="quotes">
  <div class="mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-xl font-bold text-white sm:text-2xl">Quotes</h1>
      <p class="mt-1 text-sm text-zinc-500">Your price quotations and their status</p>
    </div>
    <a href="/quote" class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-green-500">
      + Request Quote
    </a>
  </div>

  {userQuotes.length === 0 ? (
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-16 text-center">
      <svg class="mx-auto mb-4 h-16 w-16 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.75"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
      <h3 class="text-lg font-bold text-white">No quotes yet</h3>
      <p class="mt-2 text-sm text-zinc-500">Request your first quote to get started.</p>
      <a href="/quote" class="mt-6 inline-flex items-center gap-2 rounded-xl bg-green-600 px-6 py-3 text-sm font-bold text-white hover:bg-green-500">
        Request a Quote
      </a>
    </div>
  ) : (
    <div class="space-y-3">
      {userQuotes.map((quote) => (
        <div class="flex items-center justify-between rounded-xl border border-zinc-800 bg-zinc-900 p-5">
          <div>
            <div class="text-sm font-bold text-white">{quote.productType}</div>
            <div class="mt-0.5 text-xs text-zinc-500">
              {quote.quantity?.toLocaleString()} pcs · {quote.fabric || 'Standard'} · {quote.color || '—'}
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div class="hidden text-right sm:block">
              <div class="text-sm font-bold text-white">{quote.totalPrice} {quote.currency}</div>
              <div class="text-xs text-zinc-500">{quote.createdAt ? new Date(quote.createdAt).toLocaleDateString() : ''}</div>
            </div>
            <span class={`rounded-full border px-3 py-1 text-[10px] font-semibold ${statusColors[quote.status || 'pending'] || statusColors.pending}`}>
              {(quote.status || 'pending').charAt(0).toUpperCase()}{(quote.status || 'pending').slice(1)}
            </span>
          </div>
        </div>
      ))}
    </div>
  )}
</PortalLayout>