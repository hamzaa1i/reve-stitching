---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getDb } from '../../db/index';
import { orders, quotes, documents, messages } from '../../db/schema';
import { eq, and, desc, sql } from 'drizzle-orm';

const user = Astro.locals.user!;
const db = getDb();

let userOrders: typeof orders.$inferSelect[] = [];
let userQuotes: typeof quotes.$inferSelect[] = [];
let userDocs: typeof documents.$inferSelect[] = [];
let unreadCount = 0;

try {
  userOrders = await db.select().from(orders)
    .where(eq(orders.clientId, user.id))
    .orderBy(desc(orders.createdAt))
    .limit(5)
    .all();

  userQuotes = await db.select().from(quotes)
    .where(eq(quotes.clientId, user.id))
    .orderBy(desc(quotes.createdAt))
    .limit(5)
    .all();

  userDocs = await db.select().from(documents)
    .where(eq(documents.clientId, user.id))
    .orderBy(desc(documents.createdAt))
    .limit(5)
    .all();

  const unreadResult = await db.select({ count: sql<number>`cast(count(*) as integer)` }).from(messages)
    .where(and(eq(messages.recipientId, user.id), eq(messages.isRead, false)))
    .get();
  unreadCount = unreadResult?.count ?? 0;
} catch (e) {
  // Tables might be empty — that's fine
}

const totalOrders = userOrders.length;
const activeOrders = userOrders.filter(o => !['delivered', 'shipped'].includes(o.status || '')).length;
const totalDocs = userDocs.length;

const statusLabels: Record<string, string> = {
  confirmed: 'Confirmed',
  fabric_sourced: 'Fabric Sourced',
  cutting: 'Cutting',
  stitching: 'Stitching',
  qc: 'Quality Check',
  packing: 'Packing',
  shipped: 'Shipped',
  delivered: 'Delivered',
};

const statusColors: Record<string, string> = {
  confirmed: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  fabric_sourced: 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20',
  cutting: 'bg-amber-500/10 text-amber-400 border-amber-500/20',
  stitching: 'bg-orange-500/10 text-orange-400 border-orange-500/20',
  qc: 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  packing: 'bg-pink-500/10 text-pink-400 border-pink-500/20',
  shipped: 'bg-green-500/10 text-green-400 border-green-500/20',
  delivered: 'bg-green-500/10 text-green-400 border-green-500/20',
};

const quoteStatusColors: Record<string, string> = {
  pending: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/20',
  sent: 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  approved: 'bg-green-500/10 text-green-400 border-green-500/20',
  rejected: 'bg-red-500/10 text-red-400 border-red-500/20',
  expired: 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20',
};
---

<PortalLayout title="Dashboard" activePage="dashboard">
  <!-- Welcome -->
  <div class="mb-8">
    <h1 class="text-2xl font-bold text-white sm:text-3xl">
      Welcome back, <span class="text-green-400">{user?.name?.split(' ')[0] || 'there'}</span>
    </h1>
    <p class="mt-1 text-sm text-zinc-500">{user?.company || 'Here\'s an overview of your activity'}</p>
  </div>

  <!-- Stats cards -->
  <div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Total Orders</div>
      <div class="mt-2 text-3xl font-bold text-white">{totalOrders}</div>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Active</div>
      <div class="mt-2 text-3xl font-bold text-green-400">{activeOrders}</div>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Documents</div>
      <div class="mt-2 text-3xl font-bold text-white">{totalDocs}</div>
    </div>
    <div class="rounded-xl border border-zinc-800 bg-zinc-900 p-5">
      <div class="text-xs font-medium uppercase tracking-wider text-zinc-500">Unread</div>
      <div class="mt-2 text-3xl font-bold text-blue-400">{unreadCount}</div>
    </div>
  </div>

  <!-- Quick actions -->
  <div class="mb-8 flex flex-wrap gap-3">
    <a href="/portal/quotes" class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 bg-zinc-800 px-5 py-2.5 text-sm font-medium text-white transition-all hover:border-green-500/30 hover:bg-zinc-700">
      <svg class="h-4 w-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
      View Quotes
    </a>
    <a href="/portal/documents" class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 bg-zinc-800 px-5 py-2.5 text-sm font-medium text-white transition-all hover:border-green-500/30 hover:bg-zinc-700">
      <svg class="h-4 w-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
      Documents
    </a>
    <a href="/portal/messages" class="inline-flex items-center gap-2 rounded-xl border border-zinc-700 bg-zinc-800 px-5 py-2.5 text-sm font-medium text-white transition-all hover:border-green-500/30 hover:bg-zinc-700">
      <svg class="h-4 w-4 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z" /></svg>
      Messages
    </a>
    <a href="/quote" class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-green-500">
      + New Quote
    </a>
  </div>

  <!-- Two columns: Orders + Quotes -->
  <div class="grid gap-6 lg:grid-cols-2">
    <!-- Recent Orders -->
    <div class="rounded-xl border border-zinc-800 bg-zinc-900">
      <div class="flex items-center justify-between border-b border-zinc-800 px-5 py-4">
        <h2 class="text-sm font-bold text-white">Recent Orders</h2>
        <a href="/portal/orders" class="text-xs font-medium text-green-400 hover:text-green-300">View all →</a>
      </div>
      {userOrders.length === 0 ? (
        <div class="px-5 py-12 text-center">
          <svg class="mx-auto mb-3 h-10 w-10 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007zM8.625 10.5a.375.375 0 11-.75 0 .375.375 0 01.75 0zm7.5 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
          <p class="text-sm text-zinc-500">No orders yet</p>
          <p class="mt-1 text-xs text-zinc-600">Your production orders will appear here</p>
        </div>
      ) : (
        <div class="divide-y divide-zinc-800">
          {userOrders.map((order) => (
            <a href={`/portal/orders/${order.id}`} class="flex items-center justify-between px-5 py-3.5 transition-colors hover:bg-zinc-800/50">
              <div>
                <div class="text-sm font-medium text-white">{order.poNumber}</div>
                <div class="mt-0.5 text-xs text-zinc-500">{order.productType} · {order.quantity?.toLocaleString()} pcs</div>
              </div>
              <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-semibold ${statusColors[order.status || 'confirmed'] || 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20'}`}>
                {statusLabels[order.status || 'confirmed'] || order.status}
              </span>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Recent Quotes -->
    <div class="rounded-xl border border-zinc-800 bg-zinc-900">
      <div class="flex items-center justify-between border-b border-zinc-800 px-5 py-4">
        <h2 class="text-sm font-bold text-white">Recent Quotes</h2>
        <a href="/portal/quotes" class="text-xs font-medium text-green-400 hover:text-green-300">View all →</a>
      </div>
      {userQuotes.length === 0 ? (
        <div class="px-5 py-12 text-center">
          <svg class="mx-auto mb-3 h-10 w-10 text-zinc-700" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
          <p class="text-sm text-zinc-500">No quotes yet</p>
          <p class="mt-1 text-xs text-zinc-600">Request a quote to get started</p>
        </div>
      ) : (
        <div class="divide-y divide-zinc-800">
          {userQuotes.map((quote) => (
            <div class="flex items-center justify-between px-5 py-3.5">
              <div>
                <div class="text-sm font-medium text-white">{quote.productType}</div>
                <div class="mt-0.5 text-xs text-zinc-500">{quote.quantity?.toLocaleString()} pcs · {quote.totalPrice} {quote.currency}</div>
              </div>
              <span class={`rounded-full border px-2.5 py-0.5 text-[10px] font-semibold ${quoteStatusColors[quote.status || 'pending'] || 'bg-zinc-500/10 text-zinc-400 border-zinc-500/20'}`}>
                {quote.status?.charAt(0).toUpperCase()}{quote.status?.slice(1) || 'Pending'}
              </span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</PortalLayout> 