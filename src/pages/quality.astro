---
import Layout from '../layouts/Layout.astro';

const title = 'Quality Assurance';
const description =
  'Garment quality requirements, acceptance sampling, inspection planning and buyer-specific testing enquiries.';

const labTests = [
  {
    "name": "Colour Fastness",
    "standard": "ISO 105 series",
    "description": "Specify relevant washing, rubbing, light or perspiration methods and required grades with the buyer."
  },
  {
    "name": "Dimensional Stability",
    "standard": "ISO 6330 reference",
    "description": "Agree wash/dry conditions, measurement method and dimensional-change tolerance for the garment."
  },
  {
    "name": "Pilling Resistance",
    "standard": "ISO 12945 series",
    "description": "Select the appropriate pilling method, cycles and acceptance grade for the material."
  },
  {
    "name": "Fabric Strength",
    "standard": "Method by construction",
    "description": "Select tensile or bursting methods appropriate to the fabric and buyer specification."
  },
  {
    "name": "pH Value",
    "standard": "ISO 3071 reference",
    "description": "Confirm the applicable chemical specification and test scope for the intended market."
  },
  {
    "name": "Formaldehyde Content",
    "standard": "ISO 14184 series",
    "description": "Agree the relevant test method, limits and reporting requirements where applicable."
  }
];

const inspectionSteps = [
  {
    "num": "01",
    "title": "Fabric Inspection",
    "body": "Agree fabric checks for appearance, colour and weight before cutting, including the inspection method and recording requirements.",
    "metric": "Fabric review"
  },
  {
    "num": "02",
    "title": "In-Line Inspection",
    "body": "Define checks for stitch quality, construction and measurements during production. Frequency and reporting are agreed for the order.",
    "metric": "Agreed frequency"
  },
  {
    "num": "03",
    "title": "Mid-Line Audit",
    "body": "Review production against the approved sample and investigate recurring issues before completing the order.",
    "metric": "Order review"
  },
  {
    "num": "04",
    "title": "Final Inspection",
    "body": "Agree the finished-lot sampling plan, inspection level, defect classifications and acceptance/rejection numbers before inspection.",
    "metric": "Buyer QC plan"
  },
  {
    "num": "05",
    "title": "Pre-Shipment Audit",
    "body": "Confirm packing, carton marking, assortment and documentation checks against the agreed dispatch requirements.",
    "metric": "Dispatch review"
  }
];
---

<Layout title={title} description={description}>

  <!-- Breadcrumb -->
  <nav class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950" aria-label="Breadcrumb">
    <div class="mx-auto max-w-[90rem] px-6 py-4 sm:px-8 lg:px-12 xl:px-16">
      <ol class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
        <li><a href="/" class="transition-colors hover:text-green-600 dark:hover:text-green-400">Home</a></li>
        <li aria-hidden="true"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li class="font-medium text-zinc-900 dark:text-white">Quality Assurance</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-950 lg:py-28" aria-label="Quality hero">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 flex items-center justify-center gap-3" data-animate="fade-up">
          <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
          <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Quality Assurance</span>
          <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
        </div>
        <h1 class="font-serif text-3xl font-bold leading-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl" data-animate="fade-up" data-delay="0.08">
          Quality Isn't a <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Department</span>
        </h1>
        <p class="mt-6 text-base leading-relaxed text-zinc-500 dark:text-zinc-400 sm:text-lg" data-animate="fade-up" data-delay="0.16">
          Quality requirements begin with an approved specification, an agreed inspection plan and clear reporting responsibilities.
        </p>
      </div>

      <!-- Key metrics bar -->
      <div class="mx-auto mt-12 grid max-w-3xl grid-cols-3 gap-4" data-animate="fade-up" data-delay="0.2">
        <div class="rounded-xl border border-zinc-200 bg-white p-4 text-center dark:border-zinc-800 dark:bg-zinc-900">
          <div class="font-serif text-2xl font-bold text-green-600 dark:text-green-400">Review</div>
          <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-zinc-500">Defect Criteria</div>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-4 text-center dark:border-zinc-800 dark:bg-zinc-900">
          <div class="font-serif text-2xl font-bold text-green-600 dark:text-green-400">Agreed</div>
          <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-zinc-500">Inspection Plan</div>
        </div>
        <div class="rounded-xl border border-zinc-200 bg-white p-4 text-center dark:border-zinc-800 dark:bg-zinc-900">
          <div class="font-serif text-2xl font-bold text-green-600 dark:text-green-400">5 Areas</div>
          <div class="mt-1 text-[10px] font-medium uppercase tracking-wider text-zinc-500">QC Process</div>
        </div>
      </div>
    </div>
  </section>

  <!-- AQL Explained -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="AQL explained">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <div class="mb-4 flex items-center gap-3" data-animate="fade-up">
            <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">The Standard</span>
          </div>
          <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl" data-animate="fade-up" data-delay="0.08">
            What Does <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">AQL 2.5</span> Actually Mean?
          </h2>
          <p class="mt-4 text-base leading-relaxed text-zinc-500 dark:text-zinc-400" data-animate="fade-up" data-delay="0.16">
            AQL means Acceptance Quality Limit. In acceptance sampling, lot size and inspection level help determine sample size. The chosen plan and defect-class AQLs determine acceptance and rejection numbers.
          </p>
          <div class="mt-6 space-y-4" data-animate="fade-up" data-delay="0.2">
            <div class="rounded-xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <p class="text-sm text-zinc-600 dark:text-zinc-400"><strong class="text-zinc-900 dark:text-white">AQL 2.5</strong> is a plan parameter, not a rule allowing <strong class="text-green-600 dark:text-green-400">2.5% defective garments</strong> in every sample. Apply the selected plan’s actual acceptance and rejection numbers.</p>
            </div>
            <div class="rounded-xl border border-zinc-200 bg-zinc-50 p-4 dark:border-zinc-800 dark:bg-zinc-900">
              <p class="text-sm text-zinc-600 dark:text-zinc-400"><strong class="text-zinc-900 dark:text-white">Agree the plan before inspection.</strong> Define defect classifications, applicable AQLs, inspection level and lot before selecting the sample. Acceptance does not guarantee a defect-free lot.</p>
            </div>
          </div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-8 dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-left" data-delay="0.15">
          <h3 class="mb-6 text-xs font-bold uppercase tracking-wider text-zinc-900 dark:text-white">Defect Classification</h3>
          <div class="space-y-4">
            {[
              { type: 'Critical', desc: 'Safety hazard or regulatory non-compliance', tolerance: 'Buyer safety criteria', color: 'text-red-500 bg-red-500/10' },
              { type: 'Major', desc: 'Functional defect affecting saleability', tolerance: 'Agreed plan', color: 'text-amber-500 bg-amber-500/10' },
              { type: 'Minor', desc: 'Cosmetic imperfection without material functional impact', tolerance: 'Agreed plan', color: 'text-green-500 bg-green-500/10' },
            ].map((item) => (
              <div class="flex items-start gap-4 rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-700 dark:bg-zinc-800">
                <span class={`mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-bold ${item.color}`}>{item.type[0]}</span>
                <div>
                  <p class="text-sm font-bold text-zinc-900 dark:text-white">{item.type}</p>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400">{item.desc}</p>
                  <p class="mt-1 text-xs font-semibold text-zinc-700 dark:text-zinc-300">Tolerance: {item.tolerance}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5-Step Inspection Process -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-900 lg:py-28" aria-label="Inspection process">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-14 text-center" data-animate="fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Inspection Process</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl">
          Five Stages. <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Clear Criteria.</span>
        </h2>
      </div>

      <div class="space-y-4">
        {inspectionSteps.map((step, i) => (
          <div
            class="group rounded-2xl border border-zinc-200 bg-white p-6 transition-all duration-300 hover:border-green-500/30 dark:border-zinc-800 dark:bg-zinc-950 dark:hover:border-green-400/30 sm:p-8"
            data-animate="fade-up"
            data-delay={String(i * 0.08)}
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-8">
              <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-xl bg-green-500/10 font-serif text-xl font-bold text-green-600 dark:text-green-400">
                {step.num}
              </div>
              <div class="flex-1">
                <h3 class="text-base font-bold text-zinc-900 dark:text-white sm:text-lg">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{step.body}</p>
              </div>
              <div class="shrink-0">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 dark:border-green-800 dark:bg-green-900/30 dark:text-green-400">
                  <span class="h-1.5 w-1.5 rounded-full bg-green-500"></span>
                  {step.metric}
                </span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Lab Testing -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="Lab testing">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-14 text-center" data-animate="fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Lab Testing</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl">
          Tested to <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">International Standards</span>
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm text-zinc-500 dark:text-zinc-400">
          Testing methods, laboratory arrangements, sample selection and reports are confirmed against your specification. Listed methods are references, not claims of completed testing.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {labTests.map((test, i) => (
          <div
            class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 dark:border-zinc-800 dark:bg-zinc-900"
            data-animate="reveal"
            data-delay={String(i * 0.06)}
          >
            <div class="mb-3">
              <span class="inline-flex items-center rounded-md bg-green-500/10 px-2 py-1 text-[10px] font-bold uppercase tracking-wider text-green-600 dark:text-green-400">{test.standard}</span>
            </div>
            <h3 class="mb-2 text-sm font-bold text-zinc-900 dark:text-white">{test.name}</h3>
            <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{test.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-zinc-900 py-24 dark:bg-zinc-950 lg:py-32" aria-label="Call to action">
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:40px 40px"></div>
    <div class="relative z-10 mx-auto max-w-[90rem] px-6 text-center sm:px-8 lg:px-12 xl:px-16">
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl lg:text-4xl" data-animate="fade-up">
        Need Our Test Reports?
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-zinc-400" data-animate="fade-up" data-delay="0.1">
        Share the reports and compliance documentation your buyer requires. Availability, scope and any third-party testing are confirmed for your order.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row" data-animate="fade-up" data-delay="0.15">
        <a href="/quote/" class="inline-flex items-center gap-2 rounded-full bg-green-500 px-8 py-4 text-sm font-bold uppercase tracking-wider text-zinc-950 shadow-lg transition-all hover:bg-green-400" data-magnetic>
          Request Sample + Reports
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/sustainability/" class="px-5 py-4 text-sm font-medium uppercase tracking-wider text-zinc-400 transition-colors hover:text-white">
          View Sustainability →
        </a>
      </div>
    </div>
  </section>

</Layout>
