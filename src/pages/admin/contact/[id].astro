---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { formatAdminDateTime, formatAge, urgencyClass } from '../../../lib/admin-operations';

export const prerender = false;

const id = Astro.params.id || '';
const requestedReturn = Astro.url.searchParams.get('return') || '/admin/contacts';
const returnPath = requestedReturn.startsWith('/admin/contacts') ? requestedReturn : '/admin/contacts';

const supabase = createClient(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, {
  auth: { autoRefreshToken: false, persistSession: false },
});

const { data: contact, error } = await supabase
  .from('contact_submissions')
  .select('id,name,email,company,phone,subject,message,status,created_at')
  .eq('id', id)
  .maybeSingle();

if (!contact) Astro.response.status = error ? 500 : 404;
const replySubject = contact?.subject ? `Re: ${contact.subject}` : 'Re: Your inquiry to Reve Stitching';
const replyHref = contact ? `mailto:${contact.email}?subject=${encodeURIComponent(replySubject)}` : '#';
---

<AdminLayout title={contact ? `Inquiry — ${contact.name || 'Visitor'}` : 'Inquiry not found'}>
  {!contact ? (
    <div class="mx-auto max-w-2xl rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm">
      <h1 class="text-lg font-bold text-slate-900">{error ? 'Inquiry could not be loaded' : 'Inquiry not found'}</h1>
      <p class="mt-2 text-sm text-slate-500">{error ? 'Please retry. If the issue persists, check the Supabase connection.' : 'It may have been removed or the link may be invalid.'}</p>
      <a href="/admin/contacts" class="mt-5 inline-flex rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Back to submissions</a>
    </div>
  ) : (
    <div class="mx-auto max-w-6xl">
      <div class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <a href={returnPath} class="inline-flex items-center gap-1 text-sm font-semibold text-slate-600 hover:text-slate-950"><span aria-hidden="true">←</span> Back to submissions</a>
          <div class="mt-3 flex flex-wrap items-center gap-3">
            <h1 class="text-2xl font-bold text-slate-950">{contact.subject || 'Website inquiry'}</h1>
            <StatusBadge status={contact.status || 'new'} />
          </div>
          <p class="mt-1 text-sm text-slate-500">Received {formatAdminDateTime(contact.created_at)} · <span class:list={['font-semibold', urgencyClass(contact.created_at)]}>{formatAge(contact.created_at)} ago</span></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <button id="status-button" type="button" data-current-status={contact.status || 'new'} class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:cursor-wait disabled:opacity-60">
            {contact.status === 'new' ? 'Mark as read' : 'Mark as unread'}
          </button>
          <a href={replyHref} class="rounded-lg bg-green-700 px-4 py-2 text-sm font-semibold text-white hover:bg-green-800">Reply in email app</a>
        </div>
      </div>

      <div id="feedback" role="status" aria-live="polite" class="mb-4 hidden rounded-lg border px-4 py-3 text-sm"></div>

      <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_20rem]">
        <article class="min-w-0 rounded-xl border border-slate-200 bg-white shadow-sm">
          <header class="border-b border-slate-200 px-5 py-4 sm:px-6">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="truncate font-bold text-slate-950">{contact.name || 'Unknown visitor'}</p>
                <a href={`mailto:${contact.email}`} class="mt-1 block break-all text-sm font-medium text-green-700 hover:underline">{contact.email}</a>
              </div>
              <button id="copy-email" type="button" data-email={contact.email} class="shrink-0 rounded-md px-2.5 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-100">Copy email</button>
            </div>
          </header>
          <div class="px-5 py-6 sm:px-6">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Complete message</h2>
            <div class="mt-4 whitespace-pre-wrap break-words text-[15px] leading-7 text-slate-800">{contact.message || 'No message was provided.'}</div>
          </div>
        </article>

        <aside class="space-y-4">
          <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">Contact details</h2>
            <dl class="mt-4 space-y-4 text-sm">
              <div><dt class="text-xs font-medium text-slate-500">Name</dt><dd class="mt-1 break-words font-semibold text-slate-900">{contact.name || 'Not provided'}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Company</dt><dd class="mt-1 break-words text-slate-800">{contact.company || 'Not provided'}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Phone</dt><dd class="mt-1 break-words text-slate-800">{contact.phone ? <a href={`tel:${contact.phone}`} class="text-green-700 hover:underline">{contact.phone}</a> : 'Not provided'}</dd></div>
              <div><dt class="text-xs font-medium text-slate-500">Source</dt><dd class="mt-1 text-slate-800">Website submission</dd></div>
            </dl>
          </section>

          <section class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-xs leading-5 text-amber-900">
            Replying opens the configured email application. The current database does not record outbound reply history, so this action does not mark the inquiry as replied.
          </section>
        </aside>
      </div>
    </div>
  )}

  {contact && (
    <script is:inline define:vars={{ contactId: contact.id }}>
      var feedback = document.getElementById('feedback');
      function showFeedback(message, success) {
        if (!feedback) return;
        feedback.textContent = message;
        feedback.className = 'mb-4 rounded-lg border px-4 py-3 text-sm ' + (success ? 'border-green-200 bg-green-50 text-green-800' : 'border-red-200 bg-red-50 text-red-800');
      }

      document.getElementById('copy-email')?.addEventListener('click', async function() {
        try {
          await navigator.clipboard.writeText(this.dataset.email || '');
          this.textContent = 'Copied';
          setTimeout(() => { this.textContent = 'Copy email'; }, 1800);
        } catch {
          showFeedback('The email address could not be copied. Select it manually instead.', false);
        }
      });

      document.getElementById('status-button')?.addEventListener('click', async function() {
        var button = this;
        var nextStatus = button.dataset.currentStatus === 'new' ? 'read' : 'new';
        var originalText = button.textContent;
        button.disabled = true;
        button.textContent = 'Updating…';
        try {
          var response = await fetch('/api/admin/contact-status', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: contactId, status: nextStatus }),
          });
          var result = await response.json().catch(function() { return {}; });
          if (!response.ok) throw new Error(result.error || 'Update failed');
          button.dataset.currentStatus = nextStatus;
          button.textContent = nextStatus === 'new' ? 'Mark as read' : 'Mark as unread';
          showFeedback(nextStatus === 'new' ? 'Inquiry marked as unread.' : 'Inquiry marked as read.', true);
          setTimeout(function() { window.location.reload(); }, 450);
        } catch (error) {
          button.textContent = originalText;
          showFeedback(error instanceof Error ? error.message : 'The status could not be updated.', false);
        } finally {
          button.disabled = false;
        }
      });
    </script>
  )}
</AdminLayout>
