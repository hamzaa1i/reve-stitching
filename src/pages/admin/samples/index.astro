---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { formatAdminDateTime, formatAge, parsePositiveInt, sanitizePostgrestSearch, urgencyClass } from '../../../lib/admin-operations';
import type { SampleRequest, SampleStatus } from '../../../lib/types/sample';

export const prerender = false;

const validStatuses: SampleStatus[] = ['new', 'approved', 'production', 'shipped', 'delivered', 'converted', 'rejected'];
const requestedStatus = Astro.url.searchParams.get('status') || 'all';
const status = requestedStatus === 'all' || validStatuses.includes(requestedStatus as SampleStatus) ? requestedStatus : 'all';
const rawSearch = (Astro.url.searchParams.get('q') || Astro.url.searchParams.get('search') || '').trim().slice(0, 120);
const search = sanitizePostgrestSearch(rawSearch);
const page = parsePositiveInt(Astro.url.searchParams.get('page'), 1);
const perPage = 20;

const supabase = createClient(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, { auth: { autoRefreshToken: false, persistSession: false } });
let query = supabase
  .from('sample_requests')
  .select('id,reference_number,company_name,contact_person,email,product_type,fabric_type,quantity,status,created_at', { count: 'exact' })
  .order('created_at', { ascending: false })
  .range((page - 1) * perPage, page * perPage - 1);
if (status !== 'all') query = query.eq('status', status);
if (search) query = query.or(`company_name.ilike.%${search}%,email.ilike.%${search}%,reference_number.ilike.%${search}%,contact_person.ilike.%${search}%`);

const { data, count, error } = await query;
const samples = (data || []) as SampleRequest[];
const total = count || 0;
const totalPages = Math.max(1, Math.ceil(total / perPage));
---

<AdminLayout title="Sample Requests">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div><p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-700">Sales</p><h1 class="mt-1 text-2xl font-bold text-slate-950">Sample requests</h1><p class="mt-1 text-sm text-slate-500">Manage physical sample requests from buyers.</p></div>
    <a href="/samples" target="_blank" rel="noreferrer" class="self-start rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">View public form <span aria-hidden="true">↗</span></a>
  </div>

  <form method="get" class="mb-4 grid gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-[12rem_minmax(0,1fr)_auto]">
    <div><label for="sample-status" class="mb-1 block text-xs font-semibold text-slate-600">Status</label><select id="sample-status" name="status" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600/20"><option value="all" selected={status === 'all'}>All statuses</option>{validStatuses.map((value) => <option value={value} selected={status === value}>{value === 'production' ? 'In production' : value.charAt(0).toUpperCase() + value.slice(1)}</option>)}</select></div>
    <div><label for="sample-search" class="mb-1 block text-xs font-semibold text-slate-600">Search</label><input id="sample-search" name="q" value={rawSearch} maxlength="120" placeholder="Company, contact, email, or reference…" class="w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600/20" /></div>
    <div class="flex items-end gap-2"><button class="rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white">Apply</button><a href="/admin/samples" class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-100">Reset</a></div>
  </form>

  {error ? (
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 text-sm text-red-800">Sample requests could not be loaded. Please retry.</div>
  ) : samples.length === 0 ? (
    <div class="rounded-xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm"><h2 class="font-semibold text-slate-900">No sample requests found</h2><p class="mt-1 text-sm text-slate-500">Try changing the search or status filter.</p></div>
  ) : (
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500"><tr><th class="px-4 py-3">Reference</th><th class="px-4 py-3">Buyer</th><th class="px-4 py-3">Product</th><th class="px-4 py-3 text-right">Qty</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Received</th><th class="px-4 py-3 text-right"><span class="sr-only">Open</span></th></tr></thead>
          <tbody class="divide-y divide-slate-100">{samples.map((sample) => <tr class:list={['hover:bg-slate-50', sample.status === 'new' && 'bg-blue-50/30']}><td class="px-4 py-4 font-mono text-xs font-semibold text-slate-800">{sample.reference_number}</td><td class="px-4 py-4"><p class="font-semibold text-slate-900">{sample.company_name}</p><p class="text-xs text-slate-500">{sample.contact_person}</p></td><td class="px-4 py-4 capitalize text-slate-700">{sample.product_type}<p class="text-xs text-slate-500">{sample.fabric_type || 'Fabric not specified'}</p></td><td class="px-4 py-4 text-right font-semibold text-slate-900">{sample.quantity}</td><td class="px-4 py-4"><StatusBadge status={sample.status} /></td><td class="whitespace-nowrap px-4 py-4"><p class="text-xs text-slate-600">{formatAdminDateTime(sample.created_at)}</p><p class:list={['mt-1 text-xs font-semibold', sample.status === 'new' ? urgencyClass(sample.created_at) : 'text-slate-500']}>{formatAge(sample.created_at)} ago</p></td><td class="px-4 py-4 text-right"><a href={`/admin/samples/${sample.id}`} class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-green-600 hover:bg-green-50 hover:text-green-700">Open</a></td></tr>)}</tbody>
        </table>
      </div>
      <div class="divide-y divide-slate-200 md:hidden">{samples.map((sample) => <a href={`/admin/samples/${sample.id}`} class:list={['block p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-green-600', sample.status === 'new' && 'bg-blue-50/30']}><div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="truncate font-semibold text-slate-900">{sample.company_name}</p><p class="truncate font-mono text-xs text-slate-500">{sample.reference_number}</p></div><StatusBadge status={sample.status} /></div><p class="mt-3 text-sm capitalize text-slate-700">{sample.product_type} · {sample.quantity} pcs</p><p class="mt-2 text-xs text-slate-500">Received {formatAdminDateTime(sample.created_at)}</p></a>)}</div>
      <Pagination page={page} totalPages={totalPages} total={total} perPage={perPage} basePath="/admin/samples" params={{ status, q: rawSearch }} />
    </div>
  )}
</AdminLayout>
