---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Pagination from '../../components/admin/Pagination.astro';
import StatusBadge from '../../components/admin/StatusBadge.astro';
import { CHAT_STATUSES, formatAdminDateTime, formatAge, parsePositiveInt, sanitizePostgrestSearch, urgencyClass } from '../../lib/admin-operations';

export const prerender = false;

const params = Astro.url.searchParams;
const requestedStatus = params.get('status') || 'all';
const status = requestedStatus === 'all' || CHAT_STATUSES.includes(requestedStatus as any) ? requestedStatus : 'all';
const rawSearch = (params.get('q') || '').trim().slice(0, 120);
const search = sanitizePostgrestSearch(rawSearch);
const page = parsePositiveInt(params.get('page'), 1);
const perPage = 25;

const supabase = createClient(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, { auth: { autoRefreshToken: false, persistSession: false } });
let query = supabase
  .from('chat_sessions')
  .select('id,visitor_name,visitor_email,status,created_at,updated_at', { count: 'exact' })
  .order('updated_at', { ascending: false })
  .range((page - 1) * perPage, page * perPage - 1);
if (status !== 'all') query = query.eq('status', status);
if (search) query = query.or(`visitor_name.ilike.%${search}%,visitor_email.ilike.%${search}%`);

const [listResult, waitingResult, activeResult, closedResult] = await Promise.all([
  query,
  supabase.from('chat_sessions').select('id', { count: 'exact', head: true }).eq('status', 'waiting'),
  supabase.from('chat_sessions').select('id', { count: 'exact', head: true }).eq('status', 'active'),
  supabase.from('chat_sessions').select('id', { count: 'exact', head: true }).eq('status', 'closed'),
]);
const sessions = listResult.data || [];
const total = listResult.count || 0;
const totalPages = Math.max(1, Math.ceil(total / perPage));
const counts = { waiting: waitingResult.count || 0, active: activeResult.count || 0, closed: closedResult.count || 0 };
const tabs = [
  { key: 'all', label: 'All', count: counts.waiting + counts.active + counts.closed },
  { key: 'waiting', label: 'Waiting', count: counts.waiting },
  { key: 'active', label: 'Active', count: counts.active },
  { key: 'closed', label: 'Closed', count: counts.closed },
];
---

<AdminLayout title="Live Chat">
  <div class="mb-6">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-700">Communication</p>
    <h1 class="mt-1 text-2xl font-bold text-slate-950">Live chat</h1>
    <p class="mt-1 text-sm text-slate-500">Prioritize waiting visitors, continue active conversations, and review closed sessions.</p>
  </div>

  <div class="mb-4 grid grid-cols-3 gap-3">
    <a href="/admin/chats?status=waiting" class="rounded-xl border border-amber-200 bg-amber-50 p-4"><p class="text-xs font-semibold text-amber-700">Waiting</p><p class="mt-1 text-2xl font-bold text-amber-950">{counts.waiting}</p></a>
    <a href="/admin/chats?status=active" class="rounded-xl border border-green-200 bg-green-50 p-4"><p class="text-xs font-semibold text-green-700">Active</p><p class="mt-1 text-2xl font-bold text-green-950">{counts.active}</p></a>
    <a href="/admin/chats?status=closed" class="rounded-xl border border-slate-200 bg-white p-4"><p class="text-xs font-semibold text-slate-600">Closed</p><p class="mt-1 text-2xl font-bold text-slate-950">{counts.closed}</p></a>
  </div>

  <div class="mb-4 flex flex-col gap-3 rounded-xl border border-slate-200 bg-white p-3 shadow-sm sm:flex-row sm:items-center sm:justify-between">
    <nav aria-label="Chat status" class="flex gap-1 overflow-x-auto">
      {tabs.map((tab) => <a href={`/admin/chats${tab.key === 'all' ? '' : `?status=${tab.key}`}`} aria-current={status === tab.key ? 'page' : undefined} class:list={['whitespace-nowrap rounded-lg px-3 py-2 text-sm font-semibold', status === tab.key ? 'bg-slate-900 text-white' : 'text-slate-600 hover:bg-slate-100']}>{tab.label} <span class="ml-1 opacity-70">{tab.count}</span></a>)}
    </nav>
    <form method="get" class="flex gap-2">
      {status !== 'all' && <input type="hidden" name="status" value={status} />}
      <label for="chat-search" class="sr-only">Search chat visitors</label>
      <input id="chat-search" name="q" value={rawSearch} maxlength="120" placeholder="Search name or email…" class="min-w-0 flex-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-green-600 focus:outline-none focus:ring-2 focus:ring-green-600/20 sm:w-64" />
      <button class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white">Search</button>
    </form>
  </div>

  {listResult.error ? (
    <div role="alert" class="rounded-xl border border-red-200 bg-red-50 p-5 text-sm text-red-800">Chat sessions could not be loaded. Please retry.</div>
  ) : sessions.length === 0 ? (
    <div class="rounded-xl border border-slate-200 bg-white px-6 py-16 text-center shadow-sm"><h2 class="font-semibold text-slate-900">No chat sessions found</h2><p class="mt-1 text-sm text-slate-500">There are no sessions matching this filter.</p></div>
  ) : (
    <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
      <div class="hidden overflow-x-auto md:block">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500"><tr><th class="px-4 py-3">Visitor</th><th class="px-4 py-3">Status</th><th class="px-4 py-3">Started</th><th class="px-4 py-3">Last activity</th><th class="px-4 py-3 text-right"><span class="sr-only">Open</span></th></tr></thead>
          <tbody class="divide-y divide-slate-100">
            {sessions.map((session) => (
              <tr class:list={['hover:bg-slate-50', session.status === 'waiting' && 'bg-amber-50/35']}>
                <td class="px-4 py-4"><p class="font-semibold text-slate-900">{session.visitor_name || 'Anonymous visitor'}</p><p class="mt-0.5 text-xs text-slate-500">{session.visitor_email || 'No email provided'}</p></td>
                <td class="px-4 py-4"><StatusBadge status={session.status} /></td>
                <td class="whitespace-nowrap px-4 py-4 text-xs text-slate-600">{formatAdminDateTime(session.created_at)}</td>
                <td class="whitespace-nowrap px-4 py-4"><p class:list={['text-xs font-semibold', session.status === 'waiting' ? urgencyClass(session.created_at) : 'text-slate-600']}>{formatAge(session.updated_at || session.created_at)} ago</p></td>
                <td class="px-4 py-4 text-right"><a href={`/admin/chat/${session.id}`} class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:border-green-600 hover:bg-green-50 hover:text-green-700">{session.status === 'closed' ? 'Review' : 'Open'}</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="divide-y divide-slate-200 md:hidden">
        {sessions.map((session) => (
          <a href={`/admin/chat/${session.id}`} class:list={['block p-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-green-600', session.status === 'waiting' && 'bg-amber-50/35']}>
            <div class="flex items-start justify-between gap-3"><div class="min-w-0"><p class="truncate font-semibold text-slate-900">{session.visitor_name || 'Anonymous visitor'}</p><p class="truncate text-xs text-slate-500">{session.visitor_email || 'No email provided'}</p></div><StatusBadge status={session.status} /></div>
            <div class="mt-3 flex justify-between text-xs text-slate-500"><span>Started {formatAdminDateTime(session.created_at)}</span><span class="font-semibold">{formatAge(session.updated_at || session.created_at)} ago</span></div>
          </a>
        ))}
      </div>
      <Pagination page={page} totalPages={totalPages} total={total} perPage={perPage} basePath="/admin/chats" params={{ status, q: rawSearch }} />
    </div>
  )}
</AdminLayout>
