---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { createClient } from '@supabase/supabase-js';
import { getFullDashboardStats, EMPTY_STATS } from '../../lib/dashboard-stats';
import ManualTriggerButton from '../../components/admin/ManualTriggerButton.astro';

export const prerender = false;

const supabase = createClient(
  process.env.SUPABASE_URL!,
  process.env.SUPABASE_SERVICE_ROLE_KEY!,
  { auth: { autoRefreshToken: false, persistSession: false } }
);

// Fetch all data in parallel
const [statsResult, contactsResult, sessionsResult] = await Promise.all([
  getFullDashboardStats(supabase),
  supabase.from('contact_submissions').select('*').order('created_at', { ascending: false }).limit(50),
  supabase.from('chat_sessions').select('*').order('created_at', { ascending: false }).limit(50),
]);

const analytics = statsResult.data || EMPTY_STATS;
const analyticsError = statsResult.error;
const contacts = contactsResult.data || [];
const sessions = sessionsResult.data || [];

const newContacts = contacts.filter(c => c.status === 'new').length;
const waitingChats = sessions.filter(s => s.status === 'waiting').length;
const activeChats = sessions.filter(s => s.status === 'active').length;

// Month-over-month change
const quotesChange = analytics.quotes_last_month > 0 
  ? Math.round(((analytics.quotes_this_month - analytics.quotes_last_month) / analytics.quotes_last_month) * 100)
  : analytics.quotes_this_month > 0 ? 100 : 0;

function formatCurrency(value: number): string {
  if (value >= 1000000) return `$${(value / 1000000).toFixed(1)}M`;
  if (value >= 1000) return `$${(value / 1000).toFixed(0)}K`;
  return `$${value}`;
}

function formatResponseTime(hours: number): string {
  if (hours < 1) return '< 1 hr';
  if (hours < 24) return `${hours} hrs`;
  const days = Math.floor(hours / 24);
  return `${days}d ${hours % 24}h`;
}
---

<AdminLayout title="Dashboard">

{analyticsError && (
  <div class="mb-6 flex items-start gap-3 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
    <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    <div><strong>Analytics Error:</strong> {analyticsError}</div>
  </div>
)}

<!-- ═══════════════════════════════════════════════════════════════════════════
     STAT CARDS — Premium white cards with colored icon badges
     ═══════════════════════════════════════════════════════════════════════════ -->
<div class="mb-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
  <!-- Total Quotes -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-blue-50 text-blue-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
      </div>
      <a href="/admin/quotes" class="text-xs font-medium text-slate-400 transition-colors hover:text-blue-600">View →</a>
    </div>
    <p class="text-3xl font-bold text-slate-900">{analytics.total_quotes}</p>
    <p class="mt-1 text-xs font-medium text-slate-500">Total Quotes</p>
  </div>

  <!-- This Month -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-green-50 text-green-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
      </div>
      {quotesChange !== 0 && (
        <span class={`inline-flex items-center gap-0.5 rounded-full px-2 py-0.5 text-xs font-bold ${quotesChange > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}`}>
          {quotesChange > 0 ? '↑' : '↓'} {Math.abs(quotesChange)}%
        </span>
      )}
    </div>
    <p class="text-3xl font-bold text-slate-900">{analytics.quotes_this_month}</p>
    <p class="mt-1 text-xs font-medium text-slate-500">This Month</p>
  </div>

  <!-- Active Pipeline -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50 text-purple-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-slate-900">{analytics.active_quotes}</p>
    <p class="mt-1 text-xs font-medium text-slate-500">Active Quotes</p>
  </div>

  <!-- Pipeline Value -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-amber-50 text-amber-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-slate-900">{formatCurrency(analytics.pipeline_value)}</p>
    <p class="mt-1 text-xs font-medium text-slate-500">Pipeline Value</p>
  </div>

  <!-- Response Time -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-cyan-50 text-cyan-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-slate-900">{formatResponseTime(analytics.avg_response_hours)}</p>
    <p class="mt-1 text-xs font-medium text-slate-500">Avg Response</p>
  </div>

  <!-- Conversion Rate -->
  <div class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition-all hover:shadow-md">
    <div class="mb-3 flex items-center justify-between">
      <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-rose-50 text-rose-600 transition-transform group-hover:scale-110">
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-slate-900">{analytics.conversion_rate}%</p>
    <p class="mt-1 text-xs font-medium text-slate-500">Conversion</p>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     CHARTS SECTION — 2x2 grid
     ═══════════════════════════════════════════════════════════════════════════ -->
<div class="mb-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
  <!-- Quote Funnel -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-900">
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" /></svg>
      Conversion Funnel
    </h3>
    <div class="space-y-4">
      {(() => {
        const stages = [
          { label: 'New', ...analytics.funnel.new, color: 'bg-blue-500', textColor: 'text-blue-600' },
          { label: 'Reviewed', ...analytics.funnel.reviewed, color: 'bg-yellow-500', textColor: 'text-yellow-600' },
          { label: 'Quoted', ...analytics.funnel.quoted, color: 'bg-purple-500', textColor: 'text-purple-600' },
          { label: 'Won', ...analytics.funnel.won, color: 'bg-green-500', textColor: 'text-green-600' },
          { label: 'Lost', ...analytics.funnel.lost, color: 'bg-red-500', textColor: 'text-red-600' },
        ];
        const maxCount = Math.max(...stages.map(s => s.count), 1);
        return stages.map((stage) => {
          const width = Math.max((stage.count / maxCount) * 100, 2);
          return (
            <div>
              <div class="mb-1.5 flex items-center justify-between text-sm">
                <span class="font-medium text-slate-700">{stage.label}</span>
                <div class="flex items-center gap-3">
                  {stage.value > 0 && <span class="text-xs text-slate-400">{formatCurrency(stage.value)}</span>}
                  <span class={`font-bold ${stage.textColor}`}>{stage.count}</span>
                </div>
              </div>
              <div class="h-2.5 overflow-hidden rounded-full bg-slate-100">
                <div class={`h-full rounded-full ${stage.color} transition-all duration-700`} style={`width: ${width}%`} />
              </div>
            </div>
          );
        });
      })()}
    </div>
  </div>

  <!-- Monthly Trend -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-900">
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" /></svg>
      Quote Trend (6 Months)
    </h3>
    {analytics.monthlyTrend.length === 0 ? (
      <div class="flex h-40 flex-col items-center justify-center gap-2 text-slate-400">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        <p class="text-sm">No trend data yet</p>
      </div>
    ) : (
      <div class="flex h-40 items-end justify-between gap-2 pt-4">
        {(() => {
          const maxCount = Math.max(...analytics.monthlyTrend.map(m => m.count), 1);
          return analytics.monthlyTrend.map((month) => {
            const height = Math.max((month.count / maxCount) * 100, 5);
            return (
              <div class="flex flex-1 flex-col items-center gap-1">
                <span class="text-xs font-bold text-slate-900">{month.count}</span>
                <div class="relative w-full rounded-t-lg bg-slate-100" style="height: 120px;">
                  <div class="absolute bottom-0 left-0 right-0 rounded-t-lg bg-gradient-to-t from-green-600 to-green-400 transition-all duration-700" style={`height: ${height}%`} />
                </div>
                <span class="text-[10px] font-medium text-slate-500">{month.month}</span>
              </div>
            );
          });
        })()}
      </div>
    )}
  </div>

  <!-- Products Breakdown -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-900">
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
      Top Products
    </h3>
    {analytics.products.length === 0 ? (
      <div class="flex h-32 flex-col items-center justify-center gap-2 text-slate-400">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" /></svg>
        <p class="text-sm">No product data yet</p>
      </div>
    ) : (
      <div class="space-y-4">
        {(() => {
          const colors = ['bg-blue-500', 'bg-green-500', 'bg-amber-500', 'bg-purple-500', 'bg-pink-500', 'bg-cyan-500'];
          const maxCount = Math.max(...analytics.products.map(p => p.count), 1);
          return analytics.products.slice(0, 5).map((product, idx) => {
            const width = (product.count / maxCount) * 100;
            return (
              <div>
                <div class="mb-1.5 flex items-center justify-between text-sm">
                  <span class="font-medium text-slate-700">{product.product}</span>
                  <div class="flex items-center gap-2">
                    <span class="font-bold text-slate-900">{product.count}</span>
                    <span class="text-xs text-slate-400">avg: {product.avgQuantity.toLocaleString()} pcs</span>
                  </div>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                  <div class={`h-full rounded-full ${colors[idx % colors.length]} transition-all duration-500`} style={`width: ${width}%`} />
                </div>
              </div>
            );
          });
        })()}
      </div>
    )}
  </div>

  <!-- Geographic Distribution -->
  <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
    <h3 class="mb-5 flex items-center gap-2 text-sm font-bold text-slate-900">
      <svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      Geographic Distribution
    </h3>
    {analytics.geography.length === 0 ? (
      <div class="flex h-32 flex-col items-center justify-center gap-2 text-slate-400">
        <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
        <p class="text-sm">No geographic data yet</p>
      </div>
    ) : (
      <div class="space-y-4">
        {(() => {
          const colors = [
            { bg: 'bg-blue-500', text: 'text-blue-600' },
            { bg: 'bg-green-500', text: 'text-green-600' },
            { bg: 'bg-amber-500', text: 'text-amber-600' },
            { bg: 'bg-purple-500', text: 'text-purple-600' },
            { bg: 'bg-pink-500', text: 'text-pink-600' },
          ];
          const maxCount = Math.max(...analytics.geography.map(g => g.count), 1);
          return analytics.geography.map((geo, idx) => {
            const width = (geo.count / maxCount) * 100;
            const color = colors[idx % colors.length];
            return (
              <div>
                <div class="mb-1.5 flex items-center justify-between text-sm">
                  <div class="flex items-center gap-2">
                    <div class={`h-2.5 w-2.5 rounded-full ${color.bg}`}></div>
                    <span class="font-medium text-slate-700">{geo.country}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <span class={`font-bold ${color.text}`}>{geo.count}</span>
                    <span class="text-xs text-slate-400">({geo.percentage}%)</span>
                  </div>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                  <div class={`h-full rounded-full ${color.bg} transition-all duration-500`} style={`width: ${width}%`} />
                </div>
              </div>
            );
          });
        })()}
      </div>
    )}
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     AWAITING RESPONSE — Urgent quote cards
     ═══════════════════════════════════════════════════════════════════════════ -->
{analytics.oldestUnread && analytics.oldestUnread.length > 0 && (
  <div class="mb-8">
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900">
      <svg class="h-5 w-5 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
      Awaiting Response
      <span class="rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-bold text-amber-700">{analytics.oldestUnread.length} unread</span>
    </h2>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {analytics.oldestUnread.map((quote) => (
        <a href={`/admin/quote/${quote.id}`} class="group rounded-xl border border-amber-200 bg-white p-4 transition-all hover:border-amber-400 hover:shadow-md">
          <div class="mb-2 flex items-start justify-between">
            <span class="font-mono text-xs text-slate-400">{quote.reference_number}</span>
            <span class={`rounded px-1.5 py-0.5 text-xs font-bold ${quote.hoursWaiting > 48 ? 'bg-red-100 text-red-700' : quote.hoursWaiting > 24 ? 'bg-amber-100 text-amber-700' : 'bg-blue-100 text-blue-700'}`}>
              {quote.hoursWaiting}h
            </span>
          </div>
          <p class="truncate text-sm font-medium text-slate-900 transition-colors group-hover:text-green-600">{quote.company_name}</p>
        </a>
      ))}
    </div>
  </div>
)}

<!-- ═══════════════════════════════════════════════════════════════════════════
     CONTACT & CHAT STATS — Secondary stat row
     ═══════════════════════════════════════════════════════════════════════════ -->
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
    </div>
    <div><p class="text-xs font-medium text-slate-500">Total Contacts</p><p class="text-2xl font-bold text-slate-900">{contacts.length}</p></div>
  </div>
  <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
    </div>
    <div><p class="text-xs font-medium text-slate-500">New (Unread)</p><p class="text-2xl font-bold text-blue-600">{newContacts}</p></div>
  </div>
  <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-yellow-50 text-yellow-600">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
    </div>
    <div><p class="text-xs font-medium text-slate-500">Waiting Chats</p><p class="text-2xl font-bold text-amber-600">{waitingChats}</p></div>
  </div>
  <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-green-50 text-green-600">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
    </div>
    <div><p class="text-xs font-medium text-slate-500">Active Chats</p><p class="text-2xl font-bold text-green-600">{activeChats}</p></div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════════════════
     EMAIL FOLLOW-UPS + RECENT ACTIVITY
     ═══════════════════════════════════════════════════════════════════════════ -->
<div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
  <!-- Chat Sessions -->
  <div>
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
      Live Chat Sessions
    </h2>
    <div class="space-y-3">
      {sessions.length === 0 && (
        <div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-8 text-center text-slate-400">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
          <p class="text-sm">No chat sessions yet.</p>
        </div>
      )}
      {sessions.slice(0, 5).map((session) => (
        <a href={`/admin/chat/${session.id}`} class="block rounded-xl border border-slate-200 bg-white p-4 transition-all hover:border-green-500/50 hover:shadow-md">
          <div class="mb-2 flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-sm font-medium text-slate-900">{session.visitor_name || 'Anonymous Visitor'}</span>
              <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase ${session.status === 'waiting' ? 'bg-amber-100 text-amber-700' : session.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-500'}`}>{session.status}</span>
            </div>
            <span class="text-xs text-slate-400">{new Date(session.created_at).toLocaleString()}</span>
          </div>
          {session.visitor_email && <p class="text-xs text-slate-500">{session.visitor_email}</p>}
        </a>
      ))}
    </div>
  </div>

  <!-- Contact Submissions -->
  <div>
    <h2 class="mb-4 flex items-center gap-2 text-lg font-bold text-slate-900">
      <svg class="h-5 w-5 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      Contact Submissions
    </h2>
    <div class="space-y-3">
      {contacts.length === 0 && (
        <div class="flex flex-col items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white p-8 text-center text-slate-400">
          <svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          <p class="text-sm">No submissions yet.</p>
        </div>
      )}
      {contacts.slice(0, 5).map((contact) => (
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <div class="mb-2 flex items-center justify-between">
            <span class="text-sm font-medium text-slate-900">{contact.name}</span>
            <div class="flex items-center gap-2">
              <span class={`rounded-full px-2 py-0.5 text-[10px] font-bold uppercase ${contact.status === 'new' ? 'bg-blue-100 text-blue-700' : contact.status === 'read' ? 'bg-slate-100 text-slate-500' : 'bg-green-100 text-green-700'}`}>{contact.status}</span>
              <span class="text-xs text-slate-400">{new Date(contact.created_at).toLocaleString()}</span>
            </div>
          </div>
          <p class="mb-1 text-xs text-slate-500">{contact.email} {contact.company ? `• ${contact.company}` : ''}</p>
          <p class="line-clamp-2 text-sm text-slate-600">{contact.message}</p>
          {contact.status === 'new' && (
            <button data-contact-id={contact.id} class="mark-read-btn mt-3 flex items-center gap-1.5 rounded-lg border border-green-600/30 px-3 py-1.5 text-xs font-medium text-green-700 transition-colors hover:bg-green-600 hover:text-white">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Mark as Read
            </button>
          )}
        </div>
      ))}
    </div>
  </div>
</div>

<!-- Email Follow-Ups (bottom) -->
<div class="mt-6 rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
  <h2 class="mb-1 text-sm font-bold text-slate-900">Email Follow-Ups</h2>
  <p class="mb-3 text-sm text-slate-600">Manually trigger the automated follow-up email system.</p>
  <ManualTriggerButton />
</div>

<script is:inline>
  document.querySelectorAll('.mark-read-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const id = btn.getAttribute('data-contact-id');
      const res = await fetch('/api/admin/contact-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: 'read' }),
        credentials: 'include'
      });
      if (res.ok) {
        btn.innerHTML = '<svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg> Read';
        btn.disabled = true;
        btn.classList.remove('text-green-700', 'border-green-600/30', 'hover:bg-green-600', 'hover:text-white');
        btn.classList.add('text-slate-400', 'border-slate-200');
      }
    });
  });
</script>

</AdminLayout>