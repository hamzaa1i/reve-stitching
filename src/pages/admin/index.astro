---
import { createClient } from '@supabase/supabase-js';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { formatAdminDateTime, formatAge, urgencyClass } from '../../lib/admin-operations';

export const prerender = false;

const supabase = createClient(process.env.SUPABASE_URL!, process.env.SUPABASE_SERVICE_ROLE_KEY!, { auth: { autoRefreshToken: false, persistSession: false } });
const overdueCutoff = new Date(Date.now() - 48 * 60 * 60 * 1000).toISOString();

const [
  unreadContactsResult,
  pendingQuotesResult,
  overdueQuotesResult,
  newSamplesResult,
  waitingChatsResult,
  activeChatsResult,
  convertedQuotesResult,
  totalQuotesResult,
  recentContactsResult,
  recentQuotesResult,
  recentSamplesResult,
  recentChatsResult,
] = await Promise.all([
  supabase.from('contact_submissions').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  supabase.from('quote_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  supabase.from('quote_requests').select('id', { count: 'exact', head: true }).eq('status', 'new').lt('created_at', overdueCutoff),
  supabase.from('sample_requests').select('id', { count: 'exact', head: true }).eq('status', 'new'),
  supabase.from('chat_sessions').select('id', { count: 'exact', head: true }).eq('status', 'waiting'),
  supabase.from('chat_sessions').select('id', { count: 'exact', head: true }).eq('status', 'active'),
  supabase.from('quote_requests').select('id', { count: 'exact', head: true }).eq('status', 'converted'),
  supabase.from('quote_requests').select('id', { count: 'exact', head: true }),
  supabase.from('contact_submissions').select('id,name,email,subject,status,created_at').eq('status', 'new').order('created_at', { ascending: false }).limit(5),
  supabase.from('quote_requests').select('id,reference_number,company_name,contact_person,product_type,quantity,status,created_at').in('status', ['new', 'reviewed', 'quoted']).order('created_at', { ascending: false }).limit(5),
  supabase.from('sample_requests').select('id,reference_number,company_name,contact_person,product_type,status,created_at').eq('status', 'new').order('created_at', { ascending: false }).limit(5),
  supabase.from('chat_sessions').select('id,visitor_name,visitor_email,status,created_at,updated_at').in('status', ['waiting', 'active']).order('updated_at', { ascending: false }).limit(5),
]);

const operationalResults = [unreadContactsResult, pendingQuotesResult, overdueQuotesResult, newSamplesResult, waitingChatsResult, activeChatsResult, convertedQuotesResult, totalQuotesResult];
const hasCountError = operationalResults.some((result) => result.error);
const metrics = {
  unreadContacts: unreadContactsResult.count || 0,
  pendingQuotes: pendingQuotesResult.count || 0,
  overdueQuotes: overdueQuotesResult.count || 0,
  newSamples: newSamplesResult.count || 0,
  waitingChats: waitingChatsResult.count || 0,
  activeChats: activeChatsResult.count || 0,
  convertedQuotes: convertedQuotesResult.count || 0,
  totalQuotes: totalQuotesResult.count || 0,
};

const actionCards = [
  { label: 'Unread inquiries', value: metrics.unreadContacts, href: '/admin/contacts?status=new', tone: metrics.unreadContacts ? 'blue' : 'slate', note: 'Website submissions to review' },
  { label: 'Quotes awaiting review', value: metrics.pendingQuotes, href: '/admin/quotes?status=new', tone: metrics.pendingQuotes ? 'violet' : 'slate', note: 'New sales requests' },
  { label: 'Overdue quotes', value: metrics.overdueQuotes, href: '/admin/quotes?status=new&sort=oldest', tone: metrics.overdueQuotes ? 'red' : 'slate', note: 'New for more than 48 hours' },
  { label: 'Waiting chats', value: metrics.waitingChats, href: '/admin/chats?status=waiting', tone: metrics.waitingChats ? 'amber' : 'slate', note: 'Visitors needing attention' },
  { label: 'Active chats', value: metrics.activeChats, href: '/admin/chats?status=active', tone: metrics.activeChats ? 'green' : 'slate', note: 'Open conversations' },
  { label: 'New samples', value: metrics.newSamples, href: '/admin/samples?status=new', tone: metrics.newSamples ? 'cyan' : 'slate', note: 'Physical sample requests' },
];

const tones: Record<string, string> = {
  blue: 'border-blue-200 bg-blue-50 text-blue-950',
  violet: 'border-violet-200 bg-violet-50 text-violet-950',
  red: 'border-red-200 bg-red-50 text-red-950',
  amber: 'border-amber-200 bg-amber-50 text-amber-950',
  green: 'border-green-200 bg-green-50 text-green-950',
  cyan: 'border-cyan-200 bg-cyan-50 text-cyan-950',
  slate: 'border-slate-200 bg-white text-slate-950',
};

const recentIntake = [
  ...(recentContactsResult.data || []).map((item) => ({ type: 'Inquiry', title: item.subject || `Inquiry from ${item.name || 'visitor'}`, detail: item.name || item.email, created_at: item.created_at, href: `/admin/contact/${item.id}` })),
  ...(recentQuotesResult.data || []).map((item) => ({ type: 'Quote', title: item.reference_number || 'Quote request', detail: item.company_name || item.contact_person, created_at: item.created_at, href: `/admin/quote/${item.id}` })),
  ...(recentSamplesResult.data || []).map((item) => ({ type: 'Sample', title: item.reference_number || 'Sample request', detail: item.company_name || item.contact_person, created_at: item.created_at, href: `/admin/samples/${item.id}` })),
  ...(recentChatsResult.data || []).map((item) => ({ type: 'Chat', title: `${item.status === 'waiting' ? 'Waiting chat' : 'Active chat'} with ${item.visitor_name || 'visitor'}`, detail: item.visitor_email || 'No email provided', created_at: item.created_at, href: `/admin/chat/${item.id}` })),
].sort((a, b) => new Date(b.created_at).getTime() - new Date(a.created_at).getTime()).slice(0, 8);

const intakeError = [recentContactsResult, recentQuotesResult, recentSamplesResult, recentChatsResult].some((result) => result.error);
const conversionRate = metrics.totalQuotes > 0 ? Math.round((metrics.convertedQuotes / metrics.totalQuotes) * 100) : 0;
---

<AdminLayout title="Dashboard">
  <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-green-700">Overview</p>
      <h1 class="mt-1 text-2xl font-bold text-slate-950">Sales operations</h1>
      <p class="mt-1 text-sm text-slate-500">What needs attention now, based on current record statuses.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/contacts" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50">Open inbox</a>
      <a href="/admin/quotes" class="rounded-lg bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-800">Review pipeline</a>
    </div>
  </div>

  {hasCountError && <div role="alert" class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800">Some operational counts could not be loaded. Lists below may be incomplete; retry before acting on the figures.</div>}

  <section aria-labelledby="needs-attention" class="mb-7">
    <div class="mb-3 flex items-center justify-between"><h2 id="needs-attention" class="text-sm font-bold text-slate-900">Needs attention</h2><span class="text-xs text-slate-500">Exact database counts</span></div>
    <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {actionCards.map((card) => (
        <a href={card.href} class:list={['group rounded-xl border p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-600 motion-reduce:hover:translate-y-0', tones[card.tone]]}>
          <div class="flex items-start justify-between gap-3"><div><p class="text-sm font-semibold">{card.label}</p><p class="mt-1 text-xs opacity-65">{card.note}</p></div><span class="text-3xl font-bold tracking-tight">{card.value}</span></div>
          <p class="mt-4 text-xs font-semibold opacity-70 group-hover:opacity-100">Open records <span aria-hidden="true">→</span></p>
        </a>
      ))}
    </div>
  </section>

  <div class="grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(20rem,1fr)]">
    <section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm" aria-labelledby="recent-intake">
      <header class="flex items-center justify-between border-b border-slate-200 px-5 py-4"><div><h2 id="recent-intake" class="text-sm font-bold text-slate-900">Recent intake</h2><p class="mt-0.5 text-xs text-slate-500">New records only; status changes are not inferred.</p></div></header>
      {intakeError ? (
        <p class="p-5 text-sm text-red-700">Recent records could not be loaded.</p>
      ) : recentIntake.length === 0 ? (
        <p class="p-8 text-center text-sm text-slate-500">No recent operational records.</p>
      ) : (
        <div class="divide-y divide-slate-100">
          {recentIntake.map((item) => (
            <a href={item.href} class="flex items-center gap-3 px-5 py-3.5 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-green-600">
              <span class="w-14 shrink-0 rounded-md bg-slate-100 px-2 py-1 text-center text-[10px] font-bold uppercase tracking-wide text-slate-600">{item.type}</span>
              <span class="min-w-0 flex-1"><span class="block truncate text-sm font-semibold text-slate-900">{item.title}</span><span class="block truncate text-xs text-slate-500">{item.detail}</span></span>
              <span class="shrink-0 text-right"><span class="block whitespace-nowrap text-xs text-slate-500">{formatAdminDateTime(item.created_at)}</span><span class:list={['block text-xs font-semibold', urgencyClass(item.created_at)]}>{formatAge(item.created_at)} ago</span></span>
            </a>
          ))}
        </div>
      )}
    </section>

    <div class="space-y-6">
      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="recorded-outcomes">
        <h2 id="recorded-outcomes" class="text-sm font-bold text-slate-900">Recorded quote outcomes</h2>
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-lg bg-green-50 p-3"><p class="text-xs font-semibold text-green-700">Converted</p><p class="mt-1 text-2xl font-bold text-green-950">{metrics.convertedQuotes}</p></div>
          <div class="rounded-lg bg-slate-100 p-3"><p class="text-xs font-semibold text-slate-600">Conversion</p><p class="mt-1 text-2xl font-bold text-slate-950">{conversionRate}%</p></div>
        </div>
        <p class="mt-3 text-xs leading-5 text-slate-500">Conversion is converted quote records divided by all quote records. It reflects recorded statuses, not revenue.</p>
      </section>

      <section class="rounded-xl border border-amber-200 bg-amber-50 p-5" aria-labelledby="financial-reporting">
        <h2 id="financial-reporting" class="text-sm font-bold text-amber-950">Financial pipeline withheld</h2>
        <p class="mt-2 text-xs leading-5 text-amber-900">The current quote schema exposes an AI-generated per-unit price range as text, not a structured quoted total with currency. Summing it would be financially misleading, so no pipeline value is shown.</p>
      </section>

      <section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm" aria-labelledby="quick-actions">
        <h2 id="quick-actions" class="text-sm font-bold text-slate-900">Quick actions</h2>
        <div class="mt-3 grid gap-2">
          <a href="/admin/contacts?status=new" class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-700 hover:border-green-400 hover:bg-green-50">Review unread inquiries</a>
          <a href="/admin/chats?status=waiting" class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-700 hover:border-green-400 hover:bg-green-50">Answer waiting chats</a>
          <a href="/admin/email-templates" class="rounded-lg border border-slate-200 px-3 py-2.5 text-sm font-semibold text-slate-700 hover:border-green-400 hover:bg-green-50">Manage email templates</a>
        </div>
      </section>
    </div>
  </div>
</AdminLayout>
