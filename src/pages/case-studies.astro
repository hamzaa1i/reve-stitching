---
import EditorialPage from '../components/EditorialPage.astro';
import CatalogueImage from '../components/CatalogueImage.astro';
import { catalogueMedia } from '../data/catalogue-media';
import { enquiryUrl } from '../lib/catalogue/policy';
const examples = ['A049','A024','A030'].map(id=>catalogueMedia.find(s=>s.sourceId===id)!);
---
<EditorialPage title="Garment development, in detail." eyebrow="Selected work" description="Explore actual Reve-made samples as a starting point for a development conversation. Each example shows a real garment; commercial outcomes and buyer-specific production records are discussed separately.">
<section class="cat-section"><div class="cat-wrap"><div class="category-grid">{examples.map(sample=><article class="category-card"><a class="category-image" href={`/products/${sample.categorySlug}/#${sample.sampleId}`}><CatalogueImage sample={sample} /></a><div class="category-content"><p class="eyebrow">Selected sample · {sample.sampleId.toUpperCase()}</p><h2 class="!text-2xl">{sample.title}</h2><p>{sample.alt}</p><div class="card-links"><a href={`/products/${sample.categorySlug}/`}>Explore the collection →</a><a href={enquiryUrl('quote',sample.categorySlug,sample.sampleId)}>Discuss a reference</a></div></div></article>)}</div></div></section>
<section class="cat-section"><div class="cat-wrap"><h2>Your specification defines the project.</h2><p class="mt-5 max-w-3xl text-zinc-600 dark:text-zinc-300">A useful development brief brings together the reference garment, measurements, material requirements, artwork and intended order quantities. Our team can work through those requirements with you without assuming that an existing sample is identical to your future order.</p></div></section>
</EditorialPage>
