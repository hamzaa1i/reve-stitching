---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found">
  <section class="min-h-[70vh] flex items-center justify-center section-padding">
    <div class="text-center max-w-xl mx-auto">
      <p class="text-8xl font-bold text-primary/20 font-['Playfair_Display'] select-none">404</p>
      <h1 class="heading-title mt-4 mb-6">Page Not Found</h1>
      <p class="text-body mb-10">
        The page you're looking for doesn't exist or has been moved.
        Let's get you back on track.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/" class="btn-primary">Back to Home</a>
        <a href="/products" class="btn-outline">View Products</a>
        <a href="/contact" class="btn-outline">Contact Us</a>
      </div>
    </div>
  </section>
</Layout>