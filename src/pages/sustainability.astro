---
import Layout from '../layouts/Layout.astro';

const title = 'Sustainability & Ethics — Reve Stitching';
const description =
  'SEDEX certified, GOTS organic, BCI member. Ethical manufacturing with fair wages, safe conditions, and sustainable practices. Faisalabad, Pakistan.';

const certifications = [
  {
    name: 'SEDEX',
    image: '/images/certifications/sedex.svg',
    description: 'Ethical trade audit passed. Transparent supply chain practices verified by independent assessors.',
  },
  {
    name: 'GOTS',
    image: '/images/certifications/gots.svg',
    description: 'Global Organic Textile Standard. Certified for organic fibre processing, manufacturing, and labelling.',
  },
  {
    name: 'BCI',
    image: '/images/certifications/bci.svg',
    description: 'Better Cotton Initiative member. Committed to more sustainable cotton farming practices.',
  },
  {
    name: 'GRS',
    image: '/images/certifications/grs.svg',
    description: 'Global Recycled Standard. Verified recycled content in materials and responsible manufacturing.',
  },
  {
    name: 'OCS',
    image: '/images/certifications/ocs.svg',
    description: 'Organic Content Standard. Third-party verification of organic material content in finished products.',
  },
  {
    name: 'RCS',
    image: '/images/certifications/rcs.svg',
    description: 'Recycled Content Standard. Independently verified recycled input materials.',
  },
  {
    name: 'ISO 9001',
    image: '/images/certifications/iso-9001.svg',
    description: 'Quality management system certified. Consistent processes, continuous improvement, customer satisfaction.',
  },
  {
    name: 'Higg Index',
    image: '/images/certifications/higg-index.svg',
    description: 'Sustainability measurement tool. Tracking environmental and social impact across our facility.',
  },
  {
    name: 'SGS',
    image: '/images/certifications/sgs.svg',
    description: 'SGS-verified testing and compliance. Independent quality and safety assurance.',
  },
];

const pillars = [
  {
    title: 'Fair Wages',
    body: 'All employees receive above-minimum-wage compensation with annual reviews, performance bonuses, and overtime pay compliant with Pakistani labour law and international standards.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>',
  },
  {
    title: 'Safe Working Conditions',
    body: 'Climate-controlled production floor, fire safety systems, emergency exits, regular safety drills, and PPE provided to all workers. Annual third-party safety audits.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>',
  },
  {
    title: 'No Child Labour',
    body: 'Zero tolerance policy. Age verification for all employees. Regular audits by SEDEX and international buyers confirm full compliance.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>',
  },
  {
    title: 'Water Reduction',
    body: 'Closed-loop water recycling system on our dyeing line reduces freshwater consumption by 40%. All wastewater treated before discharge.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/>',
  },
  {
    title: 'Energy Efficiency',
    body: 'LED lighting throughout the facility. Energy-efficient motors on all knitting machines. Solar panels planned for 2025 installation to cover 30% of energy needs.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>',
  },
  {
    title: 'Waste Reduction',
    body: 'Fabric cutting waste below 8%. All cotton scraps recycled into industrial wiping cloths. Zero fabric waste to landfill since 2022.',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182"/>',
  },
];
---

<Layout title={title} description={description}>

  <!-- Breadcrumb -->
  <nav class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950" aria-label="Breadcrumb">
    <div class="mx-auto max-w-[90rem] px-6 py-4 sm:px-8 lg:px-12 xl:px-16">
      <ol class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
        <li><a href="/" class="transition-colors hover:text-green-600 dark:hover:text-green-400">Home</a></li>
        <li aria-hidden="true"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li class="font-medium text-zinc-900 dark:text-white">Sustainability & Ethics</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-950 lg:py-28" aria-label="Sustainability hero">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mx-auto max-w-3xl text-center">
        <div class="mb-4 flex items-center justify-center gap-3" data-animate="fade-up">
          <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
          <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Sustainability & Ethics</span>
          <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
        </div>
        <h1 class="font-serif text-3xl font-bold leading-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl" data-animate="fade-up" data-delay="0.08">
          Manufactured <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Responsibly</span>
        </h1>
        <p class="mt-6 text-base leading-relaxed text-zinc-500 dark:text-zinc-400 sm:text-lg" data-animate="fade-up" data-delay="0.16">
          Every garment we produce carries the weight of ethical practice. We hold ourselves accountable to the standards your customers deserve — and your compliance team demands.
        </p>
      </div>
    </div>
  </section>

  <!-- Certifications Grid -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="Certifications">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-14 text-center" data-animate="fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Certifications</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl">
          Independently <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Verified</span>
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm text-zinc-500 dark:text-zinc-400">
          Third-party audited. Annually renewed. Available for your compliance team to review.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
        {certifications.map((cert, i) => (
          <div
            class="group rounded-2xl border border-zinc-200 bg-zinc-50 p-6 transition-all duration-300 hover:border-green-500/30 hover:shadow-lg hover:shadow-green-600/5 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-green-400/30"
            data-animate="reveal"
            data-delay={String(i * 0.06)}
          >
            <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-xl bg-white shadow-sm dark:bg-zinc-800">
              <img src={cert.image} alt={`${cert.name} certification`} data-fallback-text={cert.name} class="h-8 w-8 object-contain" width="32" height="32" loading="lazy" />
            </div>
            <h3 class="mb-2 text-sm font-bold text-zinc-900 dark:text-white">{cert.name}</h3>
            <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{cert.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ethical & Environmental Pillars -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-900 lg:py-28" aria-label="Our commitments">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-14 text-center" data-animate="fade-up">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Our Commitments</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl">
          Six Pillars of <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Responsibility</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pillars.map((pillar, i) => (
          <div
            class="rounded-2xl border border-zinc-200 bg-white p-8 dark:border-zinc-800 dark:bg-zinc-950"
            data-animate="reveal"
            data-delay={String(i * 0.08)}
          >
            <div class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-green-500/10">
              <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={pillar.icon} />
            </div>
            <h3 class="mb-2 text-base font-bold text-zinc-900 dark:text-white">{pillar.title}</h3>
            <p class="text-sm leading-relaxed text-zinc-500 dark:text-zinc-400">{pillar.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Supply Chain Transparency -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="Supply chain">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <div class="mb-4 flex items-center gap-3" data-animate="fade-up">
            <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Transparency</span>
          </div>
          <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl" data-animate="fade-up" data-delay="0.08">
            Supply Chain <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Visibility</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-zinc-500 dark:text-zinc-400" data-animate="fade-up" data-delay="0.16">
            We track every stage — from raw fibre to finished garment. Our supply chain is open for your compliance team to audit at any time.
          </p>

          <div class="mt-8 space-y-4" data-animate="fade-up" data-delay="0.2">
            {[
              { label: 'Yarn sourced from', value: 'Certified spinners in Punjab & Sindh' },
              { label: 'Fabric knitted at', value: 'Our in-house facility, Faisalabad' },
              { label: 'Dyeing & finishing at', value: 'GOTS-certified partner units within 10km' },
              { label: 'Garment manufacturing at', value: 'Reve Stitching, Faisalabad — single site' },
              { label: 'Quality inspection at', value: 'In-house QC lab, AQL 2.5 standard' },
            ].map((item) => (
              <div class="flex items-start gap-3">
                <div class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-green-500/10">
                  <svg class="h-3 w-3 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                </div>
                <div>
                  <span class="text-xs font-semibold uppercase tracking-wider text-zinc-400">{item.label}</span>
                  <p class="text-sm font-medium text-zinc-900 dark:text-white">{item.value}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-8 dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-left" data-delay="0.15">
          <h3 class="mb-6 text-sm font-bold uppercase tracking-wider text-zinc-900 dark:text-white">Transparency Metrics</h3>
          <div class="space-y-6">
            {[
              { label: 'Supply chain visibility', value: '100%', color: 'bg-green-500' },
              { label: 'Tier 1 suppliers audited', value: '100%', color: 'bg-green-500' },
              { label: 'Tier 2 suppliers audited', value: '85%', color: 'bg-green-400' },
              { label: 'Traceability to farm level', value: '60%', color: 'bg-emerald-400' },
            ].map((metric) => (
              <div>
                <div class="mb-1.5 flex items-center justify-between">
                  <span class="text-sm text-zinc-600 dark:text-zinc-400">{metric.label}</span>
                  <span class="text-sm font-bold text-zinc-900 dark:text-white">{metric.value}</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-zinc-200 dark:bg-zinc-700">
                  <div class={`h-full rounded-full ${metric.color}`} style={`width: ${metric.value}`}></div>
                </div>
              </div>
            ))}
          </div>
          <p class="mt-6 text-xs text-zinc-400 dark:text-zinc-500">Figures based on 2024 internal audit. Updated annually.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-zinc-900 py-24 dark:bg-zinc-950 lg:py-32" aria-label="Call to action">
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:40px 40px"></div>
    <div class="relative z-10 mx-auto max-w-[90rem] px-6 text-center sm:px-8 lg:px-12 xl:px-16">
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl lg:text-4xl" data-animate="fade-up">
        Want to Audit Our Facility?
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-zinc-400" data-animate="fade-up" data-delay="0.1">
        We welcome buyer audits, virtual factory tours, and compliance team visits. Our doors — and our records — are open.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row" data-animate="fade-up" data-delay="0.15">
        <a href="/contact/" class="inline-flex items-center gap-2 rounded-full bg-green-500 px-8 py-4 text-sm font-bold uppercase tracking-wider text-zinc-950 shadow-lg transition-all hover:bg-green-400" data-magnetic>
          Schedule a Visit
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
        <a href="/quote/" class="px-5 py-4 text-sm font-medium uppercase tracking-wider text-zinc-400 transition-colors hover:text-white">
          Or Get a Quote
        </a>
      </div>
    </div>
  </section>

</Layout>