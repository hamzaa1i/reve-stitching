  <!-- Products track navigation -->
  <script is:inline>
    (function() {
      function initProductScroll() {
        var track = document.getElementById('products-track');
        if (!track) return;

        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var isMobile = window.innerWidth < 1024;

        if (!reducedMotion && !isMobile) {
          return;
        }

        track.style.overflowX = 'auto';
        track.style.scrollSnapType = 'x mandatory';
        track.style.scrollBehavior = 'smooth';

        var leftArrow = document.getElementById('products-prev');
        var rightArrow = document.getElementById('products-next');
        var cards = track.children;

        function getCardStep() {
          if (cards.length < 2) return 300;
          return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
        }

        if (leftArrow) {
          leftArrow.onclick = function() {
            var step = getCardStep();
            var current = track.scrollLeft;
            if (current < step * 0.5) {
              track.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              track.scrollBy({ left: -step, behavior: 'smooth' });
            }
          };
        }

        if (rightArrow) {
          rightArrow.onclick = function() {
            var step = getCardStep();
            track.scrollBy({ left: step, behavior: 'smooth' });
          };
        }

        function updateArrows() {
          if (!leftArrow || !rightArrow) return;
          var sl = track.scrollLeft;
          var maxScroll = track.scrollWidth - track.clientWidth;
          leftArrow.style.opacity = sl > 10 ? '1' : '0.3';
          leftArrow.style.pointerEvents = sl > 10 ? 'auto' : 'none';
          rightArrow.style.opacity = sl < maxScroll - 10 ? '1' : '0.3';
          rightArrow.style.pointerEvents = sl < maxScroll - 10 ? 'auto' : 'none';
        }

        track.addEventListener('scroll', updateArrows, { passive: true });
        window.addEventListener('resize', updateArrows);
        requestAnimationFrame(updateArrows);
      }

      document.addEventListener('astro:page-load', initProductScroll);
      initProductScroll();
    })();
  </script>
  
