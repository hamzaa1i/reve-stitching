  <!-- Reduced-motion: pinned-step panel switcher -->
  <script is:inline>
    (function(){
      var sec = document.querySelector('#process[data-pinned-steps]') || document.querySelector('[data-pinned-steps]');
      if (!sec) return;

      var panels = sec.querySelectorAll('[data-step-panel]');
      var indicators = sec.querySelectorAll('[data-step-indicator]');
      var inner = sec.children[0];
      var guard = null;
      var activeIdx = 0;
      var indicatorClickHandlers = [];

      function showMobile() {
        if (guard) { guard.disconnect(); guard = null; }
        indicatorClickHandlers.forEach(function(h) {
          h.ind.removeEventListener('click', h.fn);
        });
        indicatorClickHandlers = [];

        if (inner) {
          inner.style.setProperty('height', 'auto', 'important');
          inner.style.setProperty('display', 'block', 'important');
        }
        for (var i = 0; i < panels.length; i++) {
          panels[i].style.setProperty('display', 'flex', 'important');
          panels[i].style.setProperty('opacity', '1', 'important');
          panels[i].style.setProperty('visibility', 'visible', 'important');
          panels[i].style.setProperty('position', 'relative', 'important');
          panels[i].style.removeProperty('height');
        }
        for (var j = 0; j < indicators.length; j++) {
          indicators[j].classList.remove('is-active');
          indicators[j].style.cursor = '';
        }
      }

      function showPanel(idx) {
        activeIdx = idx;
        if (inner) {
          inner.style.setProperty('height', '100vh', 'important');
          inner.style.setProperty('display', 'flex', 'important');
        }
        for (var i = 0; i < panels.length; i++) {
          if (i === idx) {
            panels[i].style.setProperty('display', 'flex', 'important');
            panels[i].style.setProperty('opacity', '1', 'important');
            panels[i].style.setProperty('visibility', 'visible', 'important');
            panels[i].style.setProperty('position', 'relative', 'important');
            panels[i].style.setProperty('height', '100%', 'important');
          } else {
            panels[i].style.setProperty('display', 'none', 'important');
            panels[i].style.removeProperty('height');
          }
        }
        for (var j = 0; j < indicators.length; j++) {
          indicators[j].classList.toggle('is-active', j === idx);
        }
      }

      function startGuard() {
        if (guard) guard.disconnect();
        guard = new MutationObserver(function() {
          if (window.innerWidth >= 1024) showPanel(activeIdx);
        });
        for (var i = 0; i < panels.length; i++) {
          guard.observe(panels[i], { attributes: true, attributeFilter: ['style'] });
        }
      }

      function activateDesktop() {
        showPanel(0);
        startGuard();
        indicatorClickHandlers.forEach(function(h) {
          h.ind.removeEventListener('click', h.fn);
        });
        indicatorClickHandlers = [];
        for (var j = 0; j < indicators.length; j++) {
          indicators[j].style.cursor = 'pointer';
          (function(idx) {
            var fn = function() { showPanel(idx); };
            indicators[idx].addEventListener('click', fn);
            indicatorClickHandlers.push({ ind: indicators[idx], fn: fn });
          })(j);
        }
      }

      var motionMQ = window.matchMedia('(prefers-reduced-motion: reduce)');
      var isMobile = window.innerWidth < 1024;
      var isReduced = motionMQ.matches;

      if (isMobile) {
        showMobile();
      } else if (isReduced) {
        activateDesktop();
      }

      motionMQ.addEventListener('change', function(e) {
        if (window.innerWidth < 1024) return;
        if (e.matches) {
          activateDesktop();
        } else {
          if (guard) { guard.disconnect(); guard = null; }
        }
      });

      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          if (window.innerWidth < 1024) {
            showMobile();
          } else if (motionMQ.matches) {
            activateDesktop();
          }
        }, 200);
      });
    })();
  </script>


