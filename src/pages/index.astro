---
import Layout from '../layouts/Layout.astro';
import CatalogueImage from '../components/CatalogueImage.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import { catalogueMedia } from '../data/catalogue-media';
import '../styles/catalogue.css';
const hero=catalogueMedia.find(s=>s.sourceId==='A049')!;
const layer=catalogueMedia.find(s=>s.sourceId==='A024')!;
---
<Layout title="Knitted Garment Manufacturing" description="Reve Stitching — knitted garment manufacturing in Faisalabad, Pakistan. Discover our actual garment samples and develop your collection with a tailored quotation.">
<div class="catalogue"><section class="cat-hero"><div class="cat-wrap cat-hero-grid"><div class="hero-copy"><p class="eyebrow">Reve Stitching · Faisalabad, Pakistan</p><h1>Garments with character.<br /><em>Made for your brand.</em></h1><p>From the first reference to the finished garment. Explore our sample collection, share your specifications and start a considered manufacturing conversation.</p><div class="cat-actions"><a class="cat-button" href="/products/">Explore our work <span aria-hidden="true">↗</span></a><a class="cat-button secondary" href="/quote/">Request a quote</a></div></div><div class="hero-photos"><figure><CatalogueImage sample={hero} priority sizes="(max-width:699px) 50vw,26vw" /><figcaption><span>Collared collections</span><span>Reve samples</span></figcaption></figure><figure><CatalogueImage sample={layer} sizes="(max-width:699px) 40vw,21vw" /><figcaption><span>Considered layers</span><span>Made in detail</span></figcaption></figure></div></div></section><div class="cat-wrap cat-band"><span>Knitted garments</span><span>Sampling & development</span><span>Production enquiries</span></div>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">What we make</p><h2>Real garments. Real possibilities.</h2></div><p>A selection from our manufacturing portfolio, organised around the garment you want to develop.</p></div><div class="category-grid">{products.slice(0,6).map((product,index)=><ProductCard product={product} index={index} />)}</div><div class="cat-actions"><a class="cat-button secondary" href="/products/">View the full collection →</a></div></div></section>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">From concept to garment</p><h2>A clear path from your brief.</h2></div></div><ol class="process-list">{[['01','Brief & specification','Share references, measurements, materials and your intended order.'],['02','Sample development','Review the garment details, fit, artwork and finishing.'],['03','Commercial agreement','Confirm pricing, production minimums, quality requirements and schedule.'],['04','Production & delivery','Coordinate the agreed manufacturing, inspection and shipping arrangements.']].map(([n,title,body])=><li><p class="eyebrow">{n}</p><h3>{title}</h3><p>{body}</p></li>)}</ol></div></section>
<section class="cat-section"><div class="cat-wrap cat-hero-grid"><div><p class="eyebrow">Our company</p><h2>Grounded in Faisalabad.<br />Focused on your garment.</h2><p class="mt-5 text-zinc-600 dark:text-zinc-300">Reve Stitching is a knitted garment manufacturer in Pakistan’s textile heartland. Our sample portfolio brings together everyday tops, collared styles, hoodies, sweatshirts and coordinated separates.</p><div class="cat-actions"><a class="cat-button secondary" href="/about/">About Reve →</a><a href="/quality/">Our approach to quality →</a></div></div><img src="/images/hero/about.webp" width="900" height="600" alt="Reve Stitching factory frontage in Faisalabad" loading="lazy" class="w-full" /></div></section>
<section class="cat-section"><div class="cat-wrap cat-cta"><p class="eyebrow">Your next collection</p><h2>Start with the garment you have in mind.</h2><p>Send your tech pack or reference. Our team will review your requirements for a tailored quotation.</p><div class="cat-actions"><a class="cat-button" href="/quote/">Request a quote ↗</a><a class="cat-button secondary" href="/samples/">Sample development</a></div></div></section></div>
</Layout>
