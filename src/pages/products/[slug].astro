---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import { commercialPolicy, enquiryUrl } from '../../lib/catalogue/policy';
import CatalogueImage from '../../components/CatalogueImage.astro';
import SampleGallery from '../../components/SampleGallery.astro';
import '../../styles/catalogue.css';
export const prerender = true;
export function getStaticPaths() { return products.map(product => ({params: {slug:product.slug},props:{product}})); }
const {product} = Astro.props;
const representative = product.representative!;
const pageUrl = new URL(`/products/${product.slug}/`, Astro.site).href;
const schemas = { '@context':'https://schema.org','@graph':[
 { '@type':'Service', '@id':pageUrl+'#manufacturing',name:product.name+' manufacturing',description:product.description,url:pageUrl,serviceType:'Custom knitted garment manufacturing',provider:{'@type':'Organization',name:'Reve Stitching',url:Astro.site!.href},image:product.samples.map(s=>new URL(s.images.at(-1)!.src,Astro.site).href)},
 { '@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:Astro.site!.href},{'@type':'ListItem',position:2,name:'Products',item:new URL('/products/',Astro.site).href},{'@type':'ListItem',position:3,name:product.name,item:pageUrl}] }
]};
---
<Layout title={`${product.name} — Manufacturing`} description={`${product.description} Explore actual Reve garment samples and discuss your specifications for a tailored quotation.`} ogImage={representative.images.at(-1)!.src}>
<div class="catalogue">
<nav class="cat-wrap breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/products/">Products</a><span aria-hidden="true">/</span><span aria-current="page">{product.name}</span></nav>
<section class="detail-hero"><div class="cat-wrap detail-hero-grid"><div class="detail-copy"><p class="eyebrow">Reve Stitching · Sample collection</p><h1>{product.name}</h1><p>{product.description}</p><ul class="detail-options">{product.options.map(o=><li>{o}</li>)}</ul><div class="cat-actions"><a class="cat-button" href={enquiryUrl('quote',product.slug)}>Request a quote <span aria-hidden="true">↗</span></a><a class="cat-button secondary" href={enquiryUrl('samples',product.slug)}>Sample development</a></div><div class="policy-panel"><h3>Made to your specification</h3><p>{commercialPolicy.moq}</p></div></div><figure class="detail-photo"><CatalogueImage sample={representative} priority sizes="(max-width:699px) 90vw, 45vw" /><figcaption>{representative.title} · actual Reve garment sample</figcaption></figure></div></section>
<section class="cat-section" aria-labelledby="sample-heading"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">The details, up close</p><h2 id="sample-heading">Real samples. Individual character.</h2></div><p>Each photograph below is an identified sample view. Different styles are shown as separate examples, not as alternate angles of one garment.</p></div><SampleGallery samples={product.samples} /></div></section>
<section class="cat-section"><div class="cat-wrap"><div class="section-heading"><div><p class="eyebrow">Your order, reviewed individually</p><h2>Define what matters.</h2></div></div><div class="option-grid"><article class="option-panel"><h3>Fabric & construction</h3><p>Share the fibre composition, GSM, measurements and construction your brief requires. These are confirmed for your sample; they are not inferred from the photographs.</p></article><article class="option-panel"><h3>Artwork & finishing</h3><p>Discuss the graphic, embroidery, labels, trims and packaging you need. Pictured brand artwork belongs to that sample and is not offered for reuse.</p></article><article class="option-panel"><h3>Schedule & documentation</h3><p>{commercialPolicy.leadTime} Share any testing and compliance documentation requirements with your brief.</p></article></div></div></section>
<section class="cat-section"><div class="cat-wrap cat-cta"><p class="eyebrow">Develop your collection</p><h2>Your reference. Your requirements.</h2><p>{commercialPolicy.pricing}</p><div class="cat-actions"><a class="cat-button" href={enquiryUrl('quote',product.slug)}>Discuss {product.shortName.toLowerCase()} <span aria-hidden="true">↗</span></a><a class="cat-button secondary" href={enquiryUrl('samples',product.slug)}>Request a sample</a></div></div></section>
<section class="cat-section"><div class="cat-wrap"><p class="eyebrow">Keep exploring</p><h2>More from the collection.</h2><nav class="related-links" aria-label="Related garment categories">{products.filter(p=>p.slug!==product.slug).map(p=><a href={`/products/${p.slug}/`}>{p.name} →</a>)}</nav></div></section>
</div><script type="application/ld+json" set:html={JSON.stringify(schemas)} />
</Layout>
