---
import Layout from '../../layouts/Layout.astro';
import { products } from '../../data/products';
import WhatsAppWidget from '../../components/WhatsAppWidget.astro';

export const prerender = true;

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const processSteps = [
  {
    label: 'Raw Yarn',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M20.893 13.393l-1.135-1.135a2.252 2.252 0 01-.421-.585l-1.08-2.16a.414.414 0 00-.663-.107.827.827 0 01-.812.21l-1.273-.363a.89.89 0 00-.738 1.595l.587.39c.59.395.674 1.23.172 1.732l-.2.2c-.212.212-.33.498-.33.796v.41c0 .409-.11.809-.32 1.158l-1.315 2.191a2.11 2.11 0 01-1.81 1.025 1.055 1.055 0 01-1.055-1.055v-1.172c0-.92-.56-1.747-1.414-2.089l-.655-.261a2.25 2.25 0 01-1.383-2.46l.007-.042a2.25 2.25 0 01.29-.787l.09-.15a2.25 2.25 0 012.37-1.048l1.178.236a1.125 1.125 0 001.302-.795l.208-.73a1.125 1.125 0 00-.578-1.315l-.665-.332-.091.091a2.25 2.25 0 01-1.591.659h-.18c-.249 0-.487.1-.662.274a.931.931 0 01-1.458-1.137l1.411-2.353a2.25 2.25 0 00.286-.76M11.25 2.25L12 2.25"',
  },
  {
    label: 'Knitting',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42" />',
  },
  {
    label: 'Dyeing',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />',
  },
  {
    label: 'Cutting',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M7.848 8.25l1.536.887M7.848 8.25a3 3 0 11-5.196-3 3 3 0 015.196 3zm1.536.887a2.165 2.165 0 011.083 1.839c.005.351.054.695.14 1.024M9.384 9.137l2.077 1.199M7.848 15.75l1.536-.887m-1.536.887a3 3 0 11-5.196 3 3 3 0 015.196-3zm1.536-.887a2.165 2.165 0 001.083-1.838c.005-.352.054-.696.14-1.025m-1.223 2.863l2.077-1.199m0-3.328a4.323 4.323 0 012.068-1.379l5.325-1.628a4.5 4.5 0 012.48-.044l.803.215m-7.676 2.836a2.534 2.534 0 00-.965 1.695m7.676-2.836l3.326 3.326M3.312 8.837l3.326-3.326" />',
  },
  {
    label: 'Stitching',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M10.05 4.575a1.575 1.575 0 10-3.15 0v3.15a1.575 1.575 0 003.15 0v-3.15zm0 0V3m-3.15 0h3.15m0 0h3.15M10.05 7.725v1.575a1.575 1.575 0 01-3.15 0M13.95 4.575a1.575 1.575 0 10-3.15 0v3.15a1.575 1.575 0 003.15 0v-3.15zm0 0V3m-3.15 0h3.15m0 0h3.15M13.95 7.725v1.575a1.575 1.575 0 01-3.15 0" />',
  },
  {
    label: 'QC',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />',
  },
  {
    label: 'Shipped',
    icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.125-.504 1.125-1.125v-1.5c0-1.036-.84-1.875-1.875-1.875H19.5m-12.75 0H5.625c-1.036 0-1.875.84-1.875 1.875v1.5c0 .621.504 1.125 1.125 1.125h1.5m12.75-8.25H5.625m12.75 0v-4.5a1.875 1.875 0 00-1.875-1.875h-9.75A1.875 1.875 0 004.125 6v4.5m14.25 0h.375a.375.375 0 01.375.375v.375a.375.375 0 01-.375.375H4.5a.375.375 0 01-.375-.375v-.375c0-.207.168-.375.375-.375h14.25" />',
  },
];
---

<Layout
  title={`${product.name} — Manufacturing`}
  description={`${product.description} MOQ: ${product.moq} pieces. Lead time: ${product.leadTime}. SEDEX certified, ${product.certifications.join(', ')}.`}
  ogImage={product.gallery[0]}
>

  <!-- Breadcrumb -->
  <nav class="border-b border-zinc-200 bg-zinc-50 dark:border-zinc-800 dark:bg-zinc-950" aria-label="Breadcrumb">
    <div class="mx-auto max-w-[90rem] px-6 py-4 sm:px-8 lg:px-12 xl:px-16">
      <ol class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
        <li><a href="/" class="transition-colors hover:text-green-600 dark:hover:text-green-400">Home</a></li>
        <li aria-hidden="true"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li><a href="/products" class="transition-colors hover:text-green-600 dark:hover:text-green-400">Products</a></li>
        <li aria-hidden="true"><svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg></li>
        <li class="font-medium text-zinc-900 dark:text-white">{product.category}</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-950 lg:py-28" aria-label="Product hero">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <div class="mb-4 flex items-center gap-3" data-animate="fade-up">
            <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">{product.category}</span>
          </div>
          <h1 class="font-serif text-3xl font-bold leading-tight text-zinc-900 dark:text-white sm:text-5xl lg:text-6xl" data-animate="fade-up" data-delay="0.08">
            {product.name}
          </h1>
          <p class="mt-6 max-w-xl text-base leading-relaxed text-zinc-500 dark:text-zinc-400 sm:text-lg" data-animate="fade-up" data-delay="0.16">
            {product.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3" data-animate="fade-up" data-delay="0.2">
            <a
              href={`/quote/?product=${product.slug}`}
              class="inline-flex items-center gap-2 rounded-full bg-green-600 px-8 py-4 text-sm font-bold uppercase tracking-wider text-white shadow-lg shadow-green-600/20 transition-all hover:bg-green-700 dark:bg-green-500 dark:text-zinc-950 dark:hover:bg-green-400"
              data-magnetic
            >
              Get Quote for {product.category}
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </a>
            <a href="/products#calculate" class="px-5 py-4 text-sm font-medium uppercase tracking-wider text-zinc-400 transition-colors hover:text-zinc-900 dark:text-white/50 dark:hover:text-white">
              Calculate Cost
            </a>
          </div>

          <!-- Trust badges -->
          <div class="mt-8 flex flex-wrap items-center gap-2" data-animate="fade-up" data-delay="0.28">
            {product.certifications.map((cert) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-green-200 bg-green-50 px-3 py-1.5 text-xs font-semibold text-green-700 dark:border-green-800 dark:bg-green-900/30 dark:text-green-400">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                {cert}
              </span>
            ))}
          </div>
        </div>

        <div class="relative" data-animate="fade-left" data-delay="0.15">
          <div class="aspect-[4/3] overflow-hidden rounded-3xl bg-zinc-200 shadow-2xl shadow-green-600/10 dark:bg-zinc-800 dark:shadow-green-400/5">
            <img src={product.image} alt={product.name} class="h-full w-full object-cover" loading="eager" decoding="async" width="800" height="600" />
          </div>
          <div class="absolute -bottom-4 -right-4 -z-10 h-24 w-24 rounded-2xl bg-green-500/10 dark:bg-green-400/5" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Key Specs -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="Key specifications">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-up">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
            <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/></svg>
          </div>
          <div class="font-serif text-2xl font-bold text-zinc-900 dark:text-white">{product.moq}<span class="text-green-600 dark:text-green-400">+</span></div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500">Pieces MOQ</div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-up" data-delay="0.08">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
            <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="font-serif text-2xl font-bold text-zinc-900 dark:text-white">{product.leadTime}</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500">Lead Time</div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-up" data-delay="0.16">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
            <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
          </div>
          <div class="font-serif text-2xl font-bold text-zinc-900 dark:text-white">{product.fabricWeight}</div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500">Fabric Weight</div>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6 text-center dark:border-zinc-800 dark:bg-zinc-900" data-animate="fade-up" data-delay="0.24">
          <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
            <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/></svg>
          </div>
          <div class="font-serif text-2xl font-bold text-zinc-900 dark:text-white">{product.rating}<span class="text-green-600 dark:text-green-400">/5</span></div>
          <div class="mt-1 text-xs font-medium uppercase tracking-wider text-zinc-500">Quality Rating</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       PRODUCTION PROCESS VISUALIZATION
       ═══════════════════════════════════════ -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-900 lg:py-28" aria-label="Production process">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-12 text-center">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400" data-animate="fade-up">How It's Made</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl" data-animate="fade-up" data-delay="0.08">
          {product.category} <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Production Journey</span>
        </h2>
        <p class="mx-auto mt-3 max-w-lg text-sm text-zinc-500 dark:text-zinc-400" data-animate="fade-up" data-delay="0.12">
          Every {product.category.toLowerCase()} passes through seven critical stages before reaching your warehouse.
        </p>
      </div>

      <!-- Desktop: horizontal with connectors -->
      <div class="hidden md:flex md:items-start md:justify-center md:gap-0" data-stagger="0.06">
        {processSteps.map((step, i) => (
          <div class={`process-connector flex flex-col items-center px-3 lg:px-5 ${i < processSteps.length - 1 ? 'pr-6 lg:pr-10' : ''}`}>
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-white shadow-sm ring-1 ring-zinc-200 transition-all duration-300 hover:bg-green-50 hover:ring-green-300 hover:shadow-md dark:bg-zinc-800 dark:ring-zinc-700 dark:hover:bg-green-500/10 dark:hover:ring-green-500/30 lg:h-16 lg:w-16">
              <svg class="h-6 w-6 text-green-600 dark:text-green-400 lg:h-7 lg:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={step.icon} />
            </div>
            <span class="mt-3 text-xs font-semibold text-zinc-700 dark:text-zinc-300 lg:text-sm">{step.label}</span>
            <span class="mt-1 text-[10px] text-zinc-400 dark:text-zinc-500">Step {i + 1}</span>
          </div>
        ))}
      </div>

      <!-- Mobile: 2-column grid -->
      <div class="grid grid-cols-2 gap-4 md:hidden" data-stagger="0.06">
        {processSteps.map((step, i) => (
          <div class="flex flex-col items-center rounded-xl border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-zinc-800">
            <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-green-500/10">
              <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={step.icon} />
            </div>
            <span class="mt-2 text-xs font-semibold text-zinc-700 dark:text-zinc-300">{step.label}</span>
            <span class="mt-0.5 text-[10px] text-zinc-400 dark:text-zinc-500">Step {i + 1}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="bg-white py-20 dark:bg-zinc-950 lg:py-28" aria-label="Features">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="mb-12 text-center">
        <span class="mb-3 inline-block text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400" data-animate="fade-up">Features</span>
        <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl" data-animate="fade-up" data-delay="0.08">
          What Makes Our {product.category} <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Stand Out</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {product.features.map((feature, i) => (
          <div
            class="group rounded-2xl border border-zinc-200 bg-zinc-50 p-6 transition-all duration-300 hover:border-green-500/30 hover:shadow-lg hover:shadow-green-600/5 dark:border-zinc-800 dark:bg-zinc-900 dark:hover:border-green-400/30"
            data-animate="fade-up"
            data-delay={String(i * 0.08)}
            data-tilt
          >
            <div class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-green-500/10 transition-all duration-300 group-hover:bg-green-600 dark:group-hover:bg-green-500">
              <svg class="h-5 w-5 text-green-600 transition-colors group-hover:text-white dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
            </div>
            <h3 class="text-sm font-bold text-zinc-900 dark:text-white">{feature}</h3>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fabric Options -->
  <section class="bg-zinc-50 py-20 dark:bg-zinc-900 lg:py-28" aria-label="Fabric options">
    <div class="mx-auto max-w-[90rem] px-6 sm:px-8 lg:px-12 xl:px-16">
      <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">
        <div>
          <div class="mb-4 flex items-center gap-3" data-animate="fade-up">
            <span class="block h-px w-8 bg-green-600 dark:bg-green-400" aria-hidden="true"></span>
            <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-green-600 dark:text-green-400">Fabric Options</span>
          </div>
          <h2 class="font-serif text-2xl font-bold text-zinc-900 dark:text-white sm:text-4xl" data-animate="fade-up" data-delay="0.08">
            Available <span class="bg-gradient-to-r from-green-600 to-emerald-500 bg-clip-text text-transparent dark:from-green-400 dark:to-emerald-300">Fabrics</span>
          </h2>
          <p class="mt-4 text-base leading-relaxed text-zinc-500 dark:text-zinc-400" data-animate="fade-up" data-delay="0.16">
            Choose from our range of premium knitted fabrics, each tested for quality, colorfastness, and durability.
          </p>

          <div class="mt-8 space-y-3" data-animate="fade-up" data-delay="0.2">
            {product.fabrics.map((fabric) => (
              <div class="flex items-center gap-3 rounded-xl border border-zinc-200 bg-white px-5 py-3 dark:border-zinc-800 dark:bg-zinc-800">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-green-500/10">
                  <svg class="h-4 w-4 text-green-600 dark:text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M6.429 9.75L2.25 12l4.179 2.25m0-4.5l5.571 3 5.571-3m-11.142 0L2.25 7.5 12 2.25l9.75 5.25-4.179 2.25m0 0L21.75 12l-4.179 2.25m0 0L12 17.25 6.43 14.25m11.142 0l4.179 2.25L12 21.75 2.25 16.5l4.179-2.25"/>
                  </svg>
                </div>
                <span class="text-sm font-semibold text-zinc-900 dark:text-white">{fabric}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3" data-animate="fade-left" data-delay="0.15">
          {product.gallery.map((img, i) => (
            <div class={`overflow-hidden rounded-2xl bg-zinc-200 dark:bg-zinc-800 ${i === 0 ? 'col-span-2 aspect-[16/9]' : 'aspect-[4/3]'}`}>
              <img src={img} alt={`${product.name} — view ${i + 1}`} class="h-full w-full object-cover transition-transform duration-500 hover:scale-105" loading="lazy" decoding="async" width="1200" height="800" />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="relative bg-zinc-900 py-24 dark:bg-zinc-950 lg:py-32" aria-label="Call to action">
    <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true" style="background-image:radial-gradient(circle at 1px 1px, white 1px, transparent 0);background-size:40px 40px"></div>
    <div class="relative z-10 mx-auto max-w-[90rem] px-6 text-center sm:px-8 lg:px-12 xl:px-16">
      <h2 class="font-serif text-2xl font-bold text-white sm:text-3xl lg:text-4xl" data-animate="fade-up">
        Ready to Manufacture {product.category}?
      </h2>
      <p class="mx-auto mt-4 max-w-lg text-zinc-400" data-animate="fade-up" data-delay="0.1">
        Get a detailed quote within 24 hours. MOQ from {product.moq} pieces, lead time {product.leadTime}.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row" data-animate="fade-up" data-delay="0.15">
        <a
          href={`/quote/?product=${product.slug}`}
          class="inline-flex items-center gap-2 rounded-full bg-green-500 px-8 py-4 text-sm font-bold uppercase tracking-wider text-zinc-950 shadow-lg transition-all hover:bg-green-400"
          data-magnetic
        >
          Get Quote for {product.category}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="/products" class="px-5 py-4 text-sm font-medium uppercase tracking-wider text-zinc-400 transition-colors hover:text-white">
          ← All Products
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2" data-animate="fade-up" data-delay="0.2">
        {product.certifications.map((cert) => (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-zinc-700 bg-zinc-800 px-3 py-1 text-xs font-medium text-zinc-400">
            <span class="h-1.5 w-1.5 rounded-full bg-green-400"></span>
            {cert}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- Product Schema -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Product",
    "name": product.name,
    "description": product.description,
    "image": product.gallery,
    "manufacturer": {
      "@type": "Organization",
      "name": "Reve Stitching",
      "url": "https://revestitching.com"
    },
    "offers": {
      "@type": "Offer",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock",
      "eligibleQuantity": {
        "@type": "QuantitativeValue",
        "minValue": product.moq,
        "unitCode": "C62"
      }
    }
  })} />
  <WhatsAppWidget />
</Layout>