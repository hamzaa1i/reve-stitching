# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Reve Stitching — Environment Variables Template
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#
# Copy this file to `.env` (local) or set the values in your Vercel project settings.
# All variables listed here are validated at build time by src/lib/env.ts.
# Missing/invalid variables will abort the build with a descriptive error.
#
# Generate strong secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# ⚠️  NEVER commit real values to git. Only this template (.env.example) is tracked.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


# ── Supabase ──────────────────────────────────────────────────────────────────
# Used for public-facing lead capture: quotes, chat, contact, samples.
# Project URL: https://app.supabase.com → your project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-min-32-chars
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-min-32-chars


# ── Turso / libSQL (Client Portal Database) ───────────────────────────────────
# Used for the authenticated client portal: users, sessions, orders, messages,
# documents, audit_log. Create a database at https://turso.tech.
TURSO_CONNECTION_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token


# ── Admin Authentication ──────────────────────────────────────────────────────
# HMAC-token-based auth for /admin/* (separate from portal JWT).
# Generate ADMIN_JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=your-admin-jwt-secret-min-32-chars-long
ADMIN_EMAIL=admin@revestitching.com
ADMIN_PASSWORD=your-admin-password-min-12-chars


# ── Portal Authentication (JWT) ───────────────────────────────────────────────
# Used for /portal/* (client portal sessions).
# Generate JWT_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-portal-jwt-secret-min-32-chars-long


# ── Initial Admin Password (Seeder) ───────────────────────────────────────────
# Used by `npm run db:seed` (src/db/seed.ts) to create/update the portal admin.
# Can be rotated by re-running the seed with a new value.
PORTAL_ADMIN_PASSWORD=your-portal-admin-password-min-12-chars


# ── AI (GitHub Models) ────────────────────────────────────────────────────────
# Used for quote analysis (ai-summary.ts) and chatbot (chat/bot.ts).
# Create a fine-grained PAT at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_your-github-token-min-20-chars
GITHUB_MODEL=gpt-4o-mini


# ── Email (Resend) ────────────────────────────────────────────────────────────
# Used for all transactional emails.
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-api-key-min-20-chars
# Destination for contact, chat, quote, sample notifications.
NOTIFICATION_EMAIL=admin@revestitching.com
# Destination for admin reminder emails (can be same as NOTIFICATION_EMAIL).
TEAM_EMAIL=admin@revestitching.com


# ── Discord Notifications ─────────────────────────────────────────────────────
# Webhook URL for real-time notifications (new quotes, contacts, samples, errors).
# Create at: Discord channel → Integrations → Webhooks → New Webhook
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token


# ── Cloudflare Turnstile (Bot Protection) ────────────────────────────────────
# Required for public form endpoints (/api/contact, /api/quote/submit,
# /api/samples/submit). Get keys at:
#   https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=0xyour-turnstile-secret-key-min-20-chars
PUBLIC_TURNSTILE_SITE_KEY=0xyour-turnstile-site-key-min-20-chars


# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_DISPLAY_NAME=Reve Stitching
PUBLIC_WHATSAPP_NUMBER=92346507556


# ── Analytics (Optional) ──────────────────────────────────────────────────────
# Umami analytics — leave blank to disable.
PUBLIC_UMAMI_WEBSITE_ID=
# Sentry error tracking — leave blank to disable.
SENTRY_DSN=


# ── ERPNext Integration (Optional) ───────────────────────────────────────────
# When configured, quote submissions automatically create Lead records in ERPNext.
# Leave all three blank to disable the integration.
# Generate API key/secret in ERPNext: User → API Access → Generate Keys
ERPNEXT_URL=https://erp.revestitching.com
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=


# ── Site ──────────────────────────────────────────────────────────────────────
SITE_URL=https://revestitching.com
# Secret used to authenticate the Vercel Cron job that runs /api/cron/send-follow-ups.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=your-cron-secret-min-16-chars
